#ifndef EWOK_STL_UTILITY_H
#define EWOK_STL_UTILITY_H

#include <stddef.h>
#include <type_traits>

namespace std {

/* remove_reference used to be defined here.  The standard puts it in
   <type_traits>, and having it in both places made any TU that included the
   two headers fail with a redefinition error - which is what broke <mutex> and
   <thread> probes earlier.  It comes from <type_traits> now. */

/* std::swap belongs in <utility>; it used to live in <algorithm>, so code that
   included only <utility> - as Qt does in 16 places - could not find it. */
template <typename T>
void swap(T& a, T& b) {
    T tmp = static_cast<T&&>(a);
    a = static_cast<T&&>(b);
    b = static_cast<T&&>(tmp);
}

// move
template <typename T>
typename remove_reference<T>::type&& move(T&& t) noexcept {
    return static_cast<typename remove_reference<T>::type&&>(t);
}

// forward
template <typename T>
T&& forward(typename remove_reference<T>::type& t) noexcept {
    return static_cast<T&&>(t);
}

template <typename T>
T&& forward(typename remove_reference<T>::type&& t) noexcept {
    return static_cast<T&&>(t);
}

template <typename T1, typename T2>
struct pair {
    typedef T1 first_type;
    typedef T2 second_type;

    T1 first;
    T2 second;

    pair() : first(T1()), second(T2()) {}
    pair(const T1& a, const T2& b) : first(a), second(b) {}

    template <typename U, typename V>
    pair(const pair<U, V>& other) : first(other.first), second(other.second) {}

    /* Declared rather than left implicit.  The converting constructor above is a
       template, so it is not a copy constructor, and with operator= below being
       user-provided the implicit one is deprecated - -Wextra (always passed by
       make.rule) reports it as -Wdeprecated-copy the moment anything copy-
       constructs a pair, which std::map does on every insertion. */
    pair(const pair& other) : first(other.first), second(other.second) {}

    pair& operator=(const pair& other) {
        first = other.first;
        second = other.second;
        return *this;
    }

    void swap(pair& other) {
        T1 tmp_first = first;
        T2 tmp_second = second;
        first = other.first;
        second = other.second;
        other.first = tmp_first;
        other.second = tmp_second;
    }

    bool operator==(const pair& other) const {
        return first == other.first && second == other.second;
    }

    bool operator!=(const pair& other) const {
        return !(*this == other);
    }

    bool operator<(const pair& other) const {
        // Only compare first for map key comparison
        return first < other.first;
    }

    bool operator<=(const pair& other) const {
        return !(other < *this);
    }

    bool operator>(const pair& other) const {
        return other < *this;
    }

    bool operator>=(const pair& other) const {
        return !(*this < other);
    }
};

template <typename T1, typename T2>
pair<T1, T2> make_pair(const T1& a, const T2& b) {
    return pair<T1, T2>(a, b);
}

template <typename T1, typename T2>
void swap(pair<T1, T2>& a, pair<T1, T2>& b) {
    a.swap(b);
}

/* advance() and distance() used to be defined here as well as in <iterator>,
   where they are tag-dispatched.  A TU including both headers got an ambiguous
   call for every two-argument use.  <iterator> keeps the only definitions. */

}

#endif