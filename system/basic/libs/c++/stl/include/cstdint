#ifndef EWOK_STL_CSTDINT_H
#define EWOK_STL_CSTDINT_H

/*
 * <cstdint> - the fixed-width integer types, in namespace std.
 *
 * QtCore's qfloat16/qendian/qhashfunctions and the QAtomic backends name
 * std::int32_t / std::uint64_t and friends.  The global names come from the
 * compiler's freestanding <stdint.h>; this header only re-exports them.
 */

#include <stdint.h>

namespace std {

using ::int8_t;
using ::int16_t;
using ::int32_t;
using ::int64_t;

using ::uint8_t;
using ::uint16_t;
using ::uint32_t;
using ::uint64_t;

using ::int_least8_t;
using ::int_least16_t;
using ::int_least32_t;
using ::int_least64_t;

using ::uint_least8_t;
using ::uint_least16_t;
using ::uint_least32_t;
using ::uint_least64_t;

using ::int_fast8_t;
using ::int_fast16_t;
using ::int_fast32_t;
using ::int_fast64_t;

using ::uint_fast8_t;
using ::uint_fast16_t;
using ::uint_fast32_t;
using ::uint_fast64_t;

using ::intptr_t;
using ::uintptr_t;

using ::intmax_t;
using ::uintmax_t;

}

#endif // EWOK_STL_CSTDINT_H
