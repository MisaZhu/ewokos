#ifndef EWOK_STL_ALGORITHM_H
#define EWOK_STL_ALGORITHM_H

/* <stdlib.h> was missing, which made the whole header uncompilable: stable_sort
   calls malloc() at line ~315 and free() at ~347, and with no declaration in
   scope GCC rejects it with "there are no arguments to 'malloc' that depend on
   a template parameter".  92 Qt files include <algorithm>. */
#include <stddef.h>
#include <stdlib.h>
#include <utility>
/* For iterator_traits.  Every value_type below used to be spelled
   typename Iterator::value_type, which only works when Iterator is a class:
   std::array::iterator and std::string::iterator are raw pointers, where the
   qualified lookup is a hard error - "'int*' is not a class, struct, or union
   type".  <iterator> specializes iterator_traits<T*> and <const T*>, so the
   traits spelling works for both. */
#include <iterator>

/* stable_sort_impl() builds its temporary buffer with placement new.  As with
   <deque>, the omission is invisible until something actually calls stable_sort
   in a TU that has not already included <new> via <vector>. */
#include <new>

/* numeric_limits.  Nothing in this header uses it; the include exists because
   every Qt translation unit assumes <algorithm> brings it in, and the failure
   is transitive, so it surfaces in a header far away from either one.
   qglobal.h:142 includes <algorithm>, and qdrawhelper_p.h:550 does

       Simd::v_dup(std::numeric_limits<float>::epsilon())

   which produced, in ten gui translation units at once - qdrawhelper,
   qdrawhelper_neon, qblendfunctions, qcolor, qcompositionfunctions,
   qcosmeticstroker, qimage_conversions, qimagescale, qmemrotate, qrasterizer:

       error: 'numeric_limits' is not a member of 'std'
       error: expected primary-expression before 'float'

   <limits> already supplies numeric_limits<float>::epsilon() from
   __FLT_EPSILON__ via __limits_fp_traits<float>, so the values were never the
   problem.  libstdc++ reaches the same place by a longer route (<algorithm> ->
   stl_algobase.h -> <limits>), which is why Qt can rely on it without saying
   so.  No cycle: <limits> includes only <type_traits>. */
#include <limits>
/* For the braced-list max() and min() at the bottom of this header. */
#include <initializer_list>

namespace std {

/* std::swap moved to <utility>, where the standard puts it. */

template <typename T>
const T& max(const T& a, const T& b) {
    return (a > b) ? a : b;
}

template <typename T, typename Compare>
const T& max(const T& a, const T& b, Compare comp) {
    return comp(a, b) ? b : a;
}

template <typename T>
const T& min(const T& a, const T& b) {
    return (a < b) ? a : b;
}

template <typename T, typename Compare>
const T& min(const T& a, const T& b, Compare comp) {
    return comp(a, b) ? a : b;
}

template <typename Iterator>
void reverse(Iterator first, Iterator last) {
    while (first < last) {
        --last;
        if (first != last) {
            swap(*first, *last);
        }
        ++first;
    }
}

template <typename Iterator, typename Function>
Function for_each(Iterator first, Iterator last, Function fn) {
    while (first != last) {
        fn(*first);
        ++first;
    }
    return fn;
}

template <typename Iterator, typename T>
Iterator find(Iterator first, Iterator last, const T& value) {
    while (first != last) {
        if (*first == value) {
            return first;
        }
        ++first;
    }
    return last;
}

template <typename Iterator, typename BinaryPredicate>
Iterator find_if(Iterator first, Iterator last, BinaryPredicate pred) {
    while (first != last) {
        if (pred(*first)) {
            return first;
        }
        ++first;
    }
    return last;
}

template <typename Iterator, typename T>
size_t count(Iterator first, Iterator last, const T& value) {
    size_t result = 0;
    while (first != last) {
        if (*first == value) {
            ++result;
        }
        ++first;
    }
    return result;
}

template <typename Iterator>
Iterator unique(Iterator first, Iterator last) {
    if (first == last) return last;
    Iterator result = first;
    while (++first != last) {
        if (!(*result == *first)) {
            *++result = *first;
        }
    }
    return ++result;
}

/* The predicate form, which qpathclipper.cpp:1627 needs:

       y_coords.erase(std::unique(y_coords.begin(), y_coords.end(), fuzzyCompare),
                      y_coords.end());

   with `bool fuzzyCompare(qreal, qreal)` a free function, so the two-argument
   version above matches nothing:

       error: no matching function for call to 'unique(QVector<double>::iterator,
              QVector<double>::iterator, bool (&)(qreal, qreal))'

   pred takes the place of the equality test, inverted: consecutive elements
   are duplicates when pred says they are equivalent, which for a fuzzy
   comparison is the only thing "duplicate" can mean.  As in the two-argument
   form, a run collapses to its first element and the values past the returned
   iterator are left in an unspecified state, so the erase() at the call site is
   what actually shortens the vector. */
template <typename Iterator, typename BinaryPredicate>
Iterator unique(Iterator first, Iterator last, BinaryPredicate pred) {
    if (first == last) return last;
    Iterator result = first;
    while (++first != last) {
        if (!pred(*result, *first)) {
            *++result = *first;
        }
    }
    return ++result;
}

/* Defined at the bottom of this header.  Declared here so sort()'s
   depth-exhaustion fallback below can call it. */
template <typename Iterator, typename Compare>
void stable_sort_impl(Iterator first, Iterator last, Compare comp);

namespace ewok_sort_detail {

/* operator< wrapper so the two-argument sort() can share one implementation
   with the three-argument one.  A template member (not a generic lambda) to
   stay within C++11. */
struct default_less {
    template <typename A, typename B>
    bool operator()(const A& a, const B& b) const { return a < b; }
};

/* Ranges at or below this size go straight to insertion sort. */
const size_t kInsertionThreshold = 16;

/* 2 * floor(log2(n)) + 1: the recursion budget an ideal quicksort needs,
   doubled so ordinary bad-luck pivots do not trip the fallback. */
inline int depth_limit(size_t n) {
    int d = 0;
    while (n > 1) { n >>= 1; ++d; }
    return d * 2 + 1;
}

/* Insertion sort.  Only ever swaps adjacent elements, so it needs neither a
   value_type copy constructor nor a working move - relevant because the
   containers in this STL hand-write both. */
template <typename Iterator, typename Compare>
void insertion_sort(Iterator first, Iterator last, Compare comp) {
    if (first == last) return;
    for (Iterator i = first + 1; i != last; ++i) {
        for (Iterator j = i; j != first && comp(*j, *(j - 1)); --j) {
            swap(*j, *(j - 1));
        }
    }
}

template <typename Iterator, typename Compare>
void sort_loop(Iterator first, Iterator last, Compare comp, int depth) {
    while (last - first > (typename iterator_traits<Iterator>::difference_type)kInsertionThreshold) {
        if (depth <= 0) {
            /* Budget exhausted (near-sorted or adversarial input).  Hand over
               to the merge sort instead of degrading to O(n^2) or deepening
               the recursion - EwokOS thread stacks are small. */
            stable_sort_impl(first, last, comp);
            return;
        }
        --depth;

        /* Median-of-three, applied to the ELEMENTS.  The previous version
           ordered a local array of three *iterators* and then returned for
           n < 3, so a two-element range was left exactly as it was found.
           Quicksort bottoms out at two-element ranges, which made the overall
           result merely approximately sorted: callers that binary-search it
           (litehtml's css::find_selector_bucket) silently failed to find keys
           that were present. */
        Iterator mid = first + (last - first) / 2;
        Iterator hi = last - 1;
        if (comp(*mid, *first)) swap(*mid, *first);
        if (comp(*hi, *mid)) swap(*hi, *mid);
        if (comp(*mid, *first)) swap(*mid, *first);

        /* Park the median at the end and run a Lomuto partition around it.
           The pivot stays at *hi for the whole scan, so no copy is needed. */
        swap(*mid, *hi);
        Iterator store = first;
        for (Iterator i = first; i != hi; ++i) {
            if (comp(*i, *hi)) {
                swap(*i, *store);
                ++store;
            }
        }
        swap(*store, *hi);

        /* Recurse into the smaller partition, loop on the larger one: bounds
           stack depth to O(log n) regardless of pivot quality. */
        if (store - first < last - (store + 1)) {
            sort_loop(first, store, comp, depth);
            first = store + 1;
        } else {
            sort_loop(store + 1, last, comp, depth);
            last = store;
        }
    }
    insertion_sort(first, last, comp);
}

/* Introselect - quickselect with the same recursion budget sort_loop gets, and
   the same escape hatch when the budget runs out.

   The fallback is not optional.  Plain quickselect is O(n) on average and O(n^2)
   on adversarial or merely near-sorted input, and sort_loop above already
   records why that is unacceptable here: EwokOS thread stacks are small.  When
   depth hits zero the surviving range is handed to the merge sort, which is
   O(n log n) worst case and needs no budget of its own, so the whole algorithm
   is bounded by O(n log n) like sort() is.

   Partitioning is copied verbatim from sort_loop - median-of-three on the
   elements, pivot parked at the end, Lomuto scan - so the two cannot drift apart
   on the cases that comment describes.  The difference is what happens after:
   sort_loop recurses into the smaller partition and loops on the larger, whereas
   this descends into only the one partition that still contains nth and stops
   the moment nth lands on the pivot.

   [first, nth) ends up <= *nth <= [nth, last), which is the whole
   postcondition; the two sub-ranges are partitioned but not sorted, and callers
   must not assume they are. */
template <typename Iterator, typename Compare>
void nth_element_loop(Iterator first, Iterator nth, Iterator last,
                      Compare comp, int depth) {
    while (last - first > 1) {
        if (depth <= 0) {
            stable_sort_impl(first, last, comp);
            return;
        }
        --depth;

        Iterator mid = first + (last - first) / 2;
        Iterator hi = last - 1;
        if (comp(*mid, *first)) swap(*mid, *first);
        if (comp(*hi, *mid)) swap(*hi, *mid);
        if (comp(*mid, *first)) swap(*mid, *first);

        swap(*mid, *hi);
        Iterator store = first;
        for (Iterator i = first; i != hi; ++i) {
            if (comp(*i, *hi)) {
                swap(*i, *store);
                ++store;
            }
        }
        swap(*store, *hi);

        /* *store is the pivot in its final sorted position.  If that is the
           position we were asked for, stop; otherwise keep only the side of the
           partition that nth falls in. */
        if (nth == store) {
            return;
        } else if (nth < store) {
            last = store;
        } else {
            first = store + 1;
        }
    }
}

} // namespace ewok_sort_detail

template <typename Iterator>
void sort(Iterator first, Iterator last) {
    if (first >= last) return;
    ewok_sort_detail::sort_loop(first, last, ewok_sort_detail::default_less(),
                                ewok_sort_detail::depth_limit((size_t)(last - first)));
}

template <typename Iterator, typename Compare>
void sort(Iterator first, Iterator last, Compare comp) {
    if (first >= last) return;
    ewok_sort_detail::sort_loop(first, last, comp,
                                ewok_sort_detail::depth_limit((size_t)(last - first)));
}

/* nth_element.  QtConcurrent's Median<T>::median() is the caller that showed up
   missing - qtconcurrentmedian.h:114 selects the middle of a sliding window of
   timings - but it is a [alg.nth.element] requirement like any other, so it is
   implemented properly rather than as `sort()` in disguise.

   nth == last is legal and vacuous: the postcondition says nothing about where
   any particular element goes, so returning is correct and avoids the loop
   below partitioning against an iterator it must never dereference. */
template <typename Iterator>
void nth_element(Iterator first, Iterator nth, Iterator last) {
    if (first == last || nth == last) return;
    ewok_sort_detail::nth_element_loop(first, nth, last,
                                       ewok_sort_detail::default_less(),
                                       ewok_sort_detail::depth_limit((size_t)(last - first)));
}

template <typename Iterator, typename Compare>
void nth_element(Iterator first, Iterator nth, Iterator last, Compare comp) {
    if (first == last || nth == last) return;
    ewok_sort_detail::nth_element_loop(first, nth, last, comp,
                                       ewok_sort_detail::depth_limit((size_t)(last - first)));
}

template <typename Iterator, typename T>
Iterator lower_bound(Iterator first, Iterator last, const T& value) {
    size_t len = last - first;
    size_t half;
    Iterator middle;
    while (len > 0) {
        half = len / 2;
        middle = first + half;
        if (*middle < value) {
            first = middle + 1;
            len = len - half - 1;
        } else {
            len = half;
        }
    }
    return first;
}

template <typename Iterator, typename T, typename Compare>
Iterator lower_bound(Iterator first, Iterator last, const T& value, Compare comp) {
    size_t len = last - first;
    size_t half;
    Iterator middle;
    while (len > 0) {
        half = len / 2;
        middle = first + half;
        if (comp(*middle, value)) {
            first = middle + 1;
            len = len - half - 1;
        } else {
            len = half;
        }
    }
    return first;
}

template <typename Iterator, typename T>
Iterator upper_bound(Iterator first, Iterator last, const T& value) {
    size_t len = last - first;
    size_t half;
    Iterator middle;
    while (len > 0) {
        half = len / 2;
        middle = first + half;
        if (value < *middle) {
            len = half;
        } else {
            first = middle + 1;
            len = len - half - 1;
        }
    }
    return first;
}

/* Predicate version, mirroring lower_bound above.  qthreadpool.cpp:226 passes a
 * plain function pointer as the comparator:
 *
 *     std::upper_bound(d->queue.cbegin(), d->queue.cend(), expiryTimeout,
 *                      [](int expiryTimeout, const QueuePage *p) { ... });
 *
 * which without this overload matches nothing at all.  The comparator argument
 * order is comp(value, element) - the reverse of lower_bound's
 * comp(element, value) - because upper_bound is looking for the first element
 * that the value is *not* less-than-equivalent to, i.e. the first for which
 * comp(value, element) holds. */
template <typename Iterator, typename T, typename Compare>
Iterator upper_bound(Iterator first, Iterator last, const T& value, Compare comp) {
    size_t len = last - first;
    size_t half;
    Iterator middle;
    while (len > 0) {
        half = len / 2;
        middle = first + half;
        if (comp(value, *middle)) {
            len = half;
        } else {
            first = middle + 1;
            len = len - half - 1;
        }
    }
    return first;
}

/* equal_range is lower_bound and upper_bound as one result.  The caller that
   showed up missing is qplatformtheme.cpp:654:

       std::pair<const QKeyBinding *, const QKeyBinding *> range =
           std::equal_range(QPlatformThemePrivate::keyBindings,
                            QPlatformThemePrivate::keyBindings
                                + QPlatformThemePrivate::numberOfKeyBindings,
                            key, ByStandardKey());

   `key` is a QKeySequence::StandardKey and the elements are QKeyBinding, so
   ByStandardKey carries all four cross-typed operator() overloads.  That works
   only because lower_bound calls comp(element, value) and upper_bound calls
   comp(value, element) - a comparator written for a single type would not
   compile here, and neither bound can be swapped for the other.  The return
   type is pair<Iterator, Iterator>, which is what the call site declares. */
template <typename Iterator, typename T>
pair<Iterator, Iterator> equal_range(Iterator first, Iterator last, const T& value) {
    return pair<Iterator, Iterator>(lower_bound(first, last, value),
                                    upper_bound(first, last, value));
}

template <typename Iterator, typename T, typename Compare>
pair<Iterator, Iterator> equal_range(Iterator first, Iterator last, const T& value, Compare comp) {
    return pair<Iterator, Iterator>(lower_bound(first, last, value, comp),
                                    upper_bound(first, last, value, comp));
}

template <typename Iterator1, typename Iterator2>
bool equal(Iterator1 first1, Iterator1 last1, Iterator2 first2) {
    while (first1 != last1) {
        if (!(*first1 == *first2)) {
            return false;
        }
        ++first1;
        ++first2;
    }
    return true;
}

template <typename Iterator, typename T>
void fill(Iterator first, Iterator last, const T& value) {
    while (first != last) {
        *first = value;
        ++first;
    }
}

/* The counted form of fill.  qrandom.cpp:317 uses it to fill a fallback buffer:
       std::fill_n(buffer, count, value);
   and count there is a qsizetype, so Size has to be a template parameter rather
   than a size_t - the caller's signedness is not ours to choose. */
template <typename OutputIt, typename Size, typename T>
OutputIt fill_n(OutputIt first, Size n, const T& value) {
    for (Size i = 0; i < n; i++) {
        *first = value;
        ++first;
    }
    return first;
}

/* generate takes the generator by value, as the standard specifies, which is why
   qrandom.cpp:314 can hand it a whole mersenne_twister_engine and qrandom.h:158
   a lambda:
       std::generate(ptr, ptr + left, generator);
       std::generate(begin, end, [this]() { return generate(); });
   Passing by value means the engine has to be copyable, and each call site gets
   its own advancing copy rather than sharing state with the caller's. */
template <typename OutputIt, typename Generator>
void generate(OutputIt first, OutputIt last, Generator gen) {
    while (first != last) {
        *first = gen();
        ++first;
    }
}

template <typename OutputIt, typename Size, typename Generator>
OutputIt generate_n(OutputIt first, Size n, Generator gen) {
    for (Size i = 0; i < n; i++) {
        *first = gen();
        ++first;
    }
    return first;
}

template <typename Iterator1, typename Iterator2>
Iterator2 copy(Iterator1 first, Iterator1 last, Iterator2 result) {
    while (first != last) {
        *result = *first;
        ++first;
        ++result;
    }
    return result;
}

template <typename Iterator1, typename Iterator2>
Iterator2 copy_backward(Iterator1 first, Iterator1 last, Iterator2 result) {
    while (first != last) {
        --result;
        --last;
        *result = *last;
    }
    return result;
}

template <typename Iterator1, typename Iterator2>
Iterator2 move(Iterator1 first, Iterator1 last, Iterator2 result) {
    /* This used to be `*result = *first;` - a *copy*.  For a range of move-only
       elements that is a hard error, not just slow: qlogging.cpp:1286 does
       std::move over a vector<unique_ptr<const char[]>> and hit
       `use of deleted function unique_ptr<T[],D>::operator=(const unique_ptr&)`.
       A move algorithm that copies is worse than no move algorithm, because the
       caller believes the source was drained. */
    while (first != last) {
        *result = std::move(*first);
        ++first;
        ++result;
    }
    return result;
}

template <typename Iterator>
bool is_sorted(Iterator first, Iterator last) {
    if (first == last) return true;
    for (Iterator it = first + 1; it != last; ++it) {
        if (*it < *first) {
            return false;
        }
        first = it;
    }
    return true;
}

template <typename Iterator, typename Compare>
bool is_sorted(Iterator first, Iterator last, Compare comp) {
    if (first == last) return true;
    for (Iterator it = first + 1; it != last; ++it) {
        if (comp(*it, *first)) {
            return false;
        }
        first = it;
    }
    return true;
}

/* binary_search returns bool, not an iterator.  It used to return `Iterator`
   and hand back either the found position or `last`, which broke every caller
   that uses it as a predicate: qtimezoneprivate.cpp:498 is
       return std::binary_search(tzIds.begin(), tzIds.end(), ianaId);
   and the error was `cannot convert 'QList<QByteArray>::const_iterator' to
   'bool' in return`.  The iterator-returning algorithm is lower_bound, which
   this file already has; binary_search is specified as lower_bound plus an
   equivalence test. */
template <typename Iterator, typename T>
bool binary_search(Iterator first, Iterator last, const T& value) {
    Iterator it = lower_bound(first, last, value);
    return it != last && !(value < *it);
}

template <typename Iterator, typename T, typename Compare>
bool binary_search(Iterator first, Iterator last, const T& value, Compare comp) {
    Iterator it = lower_bound(first, last, value, comp);
    return it != last && !comp(value, *it);
}

// remove algorithm
template <typename Iterator, typename T>
Iterator remove(Iterator first, Iterator last, const T& value) {
    Iterator result = first;
    while (first != last) {
        if (!(*first == value)) {
            *result = *first;
            ++result;
        }
        ++first;
    }
    return result;
}

// Stable sort implementation using merge sort
template <typename Iterator, typename Compare>
void stable_sort_impl(Iterator first, Iterator last, Compare comp) {
    size_t n = last - first;
    if (n <= 1) return;

    size_t mid = n / 2;
    Iterator middle = first + mid;

    stable_sort_impl(first, middle, comp);
    stable_sort_impl(middle, last, comp);

    // Merge step - use a temporary buffer
    typedef typename iterator_traits<Iterator>::value_type value_type;
    value_type* temp = (value_type*)malloc(n * sizeof(value_type));

    Iterator left = first;
    Iterator right = middle;
    size_t i = 0;

    while (left < middle && right < last) {
        if (comp(*right, *left)) {
            new (&temp[i++]) value_type(*right);
            ++right;
        } else {
            new (&temp[i++]) value_type(*left);
            ++left;
        }
    }

    while (left < middle) {
        new (&temp[i++]) value_type(*left);
        ++left;
    }

    while (right < last) {
        new (&temp[i++]) value_type(*right);
        ++right;
    }

    // Copy back
    for (size_t j = 0; j < n; j++) {
        first[j] = temp[j];
        temp[j].~value_type();
    }

    free(temp);
}

template <typename Iterator>
void stable_sort(Iterator first, Iterator last) {
    stable_sort_impl(first, last, [](const auto& a, const auto& b) { return a < b; });
}

template <typename Iterator, typename Compare>
void stable_sort(Iterator first, Iterator last, Compare comp) {
    stable_sort_impl(first, last, comp);
}

/* ------------------------------------------------------------------ */
/* Non-modifying, modifying and set algorithms                          */
/* ------------------------------------------------------------------ */

/* Added against a measured gap list: a full Qt 5.15 corelib cross-build
   reports lexicographical_compare 1222 times, rotate 846, is_permutation 225,
   remove_if 12, partition_point 7, set_intersection 2, any_of 2, and one each
   of set_union, remove_copy_if, none_of, min_element and adjacent_find.  The
   others here (all_of, count_if, transform, copy_if, remove_copy, max_element)
   were not reached because the build died earlier, but gui and widgets use
   them, so they come along now rather than in a second pass.

   Like the rest of this header these assume random-access iterators where the
   standard would accept weaker ones - lower_bound above already does `last -
   first`, sort() does `first >= last`, reverse() does `first < last`.  Every
   iterator Qt hands them (QVector's, QList's, QString's, std::vector's) is
   random access, so the assumption holds; it is stated rather than hidden
   because it is a real narrowing of the standard's contract. */

template <typename Iterator, typename Predicate>
bool any_of(Iterator first, Iterator last, Predicate pred) {
    for (; first != last; ++first) {
        if (pred(*first)) return true;
    }
    return false;
}

template <typename Iterator, typename Predicate>
bool all_of(Iterator first, Iterator last, Predicate pred) {
    for (; first != last; ++first) {
        if (!pred(*first)) return false;
    }
    return true;
}

template <typename Iterator, typename Predicate>
bool none_of(Iterator first, Iterator last, Predicate pred) {
    return !any_of(first, last, pred);
}

/* difference_type, as the standard specifies and libstdc++ returns.  count()
   above returns size_t instead; that inconsistency is left alone rather than
   changed, since count() is already exercised by the verified probe suite and
   the difference only shows in a -Wsign-compare against a container size(). */
template <typename Iterator, typename Predicate>
typename iterator_traits<Iterator>::difference_type
count_if(Iterator first, Iterator last, Predicate pred) {
    typename iterator_traits<Iterator>::difference_type result = 0;
    for (; first != last; ++first) {
        if (pred(*first)) ++result;
    }
    return result;
}

template <typename Iterator>
Iterator adjacent_find(Iterator first, Iterator last) {
    if (first == last) return last;
    Iterator next = first;
    ++next;
    while (next != last) {
        if (*first == *next) return first;
        first = next;
        ++next;
    }
    return last;
}

template <typename Iterator, typename BinaryPredicate>
Iterator adjacent_find(Iterator first, Iterator last, BinaryPredicate pred) {
    if (first == last) return last;
    Iterator next = first;
    ++next;
    while (next != last) {
        if (pred(*first, *next)) return first;
        first = next;
        ++next;
    }
    return last;
}

template <typename Iterator>
Iterator min_element(Iterator first, Iterator last) {
    if (first == last) return last;
    Iterator smallest = first;
    for (++first; first != last; ++first) {
        if (*first < *smallest) smallest = first;
    }
    return smallest;
}

template <typename Iterator, typename Compare>
Iterator min_element(Iterator first, Iterator last, Compare comp) {
    if (first == last) return last;
    Iterator smallest = first;
    for (++first; first != last; ++first) {
        if (comp(*first, *smallest)) smallest = first;
    }
    return smallest;
}

template <typename Iterator>
Iterator max_element(Iterator first, Iterator last) {
    if (first == last) return last;
    Iterator largest = first;
    for (++first; first != last; ++first) {
        if (*largest < *first) largest = first;
    }
    return largest;
}

template <typename Iterator, typename Compare>
Iterator max_element(Iterator first, Iterator last, Compare comp) {
    if (first == last) return last;
    Iterator largest = first;
    for (++first; first != last; ++first) {
        if (comp(*largest, *first)) largest = first;
    }
    return largest;
}

template <typename InputIt, typename OutputIt, typename UnaryOp>
OutputIt transform(InputIt first, InputIt last, OutputIt d_first, UnaryOp op) {
    for (; first != last; ++first, (void)++d_first) {
        *d_first = op(*first);
    }
    return d_first;
}

template <typename InputIt1, typename InputIt2, typename OutputIt, typename BinaryOp>
OutputIt transform(InputIt1 first1, InputIt1 last1, InputIt2 first2, OutputIt d_first, BinaryOp op) {
    for (; first1 != last1; ++first1, (void)++first2, (void)++d_first) {
        *d_first = op(*first1, *first2);
    }
    return d_first;
}

template <typename InputIt, typename OutputIt, typename Predicate>
OutputIt copy_if(InputIt first, InputIt last, OutputIt d_first, Predicate pred) {
    for (; first != last; ++first) {
        if (pred(*first)) {
            *d_first = *first;
            ++d_first;
        }
    }
    return d_first;
}

/* Structured like libstdc++'s: locate the first match, then shift everything
   after it down.  The naive "copy when not removed, starting from first" form
   self-assigns every element before the first match, which is wasteful and,
   for a type whose self-assignment is not a no-op, observable. */
template <typename Iterator, typename Predicate>
Iterator remove_if(Iterator first, Iterator last, Predicate pred) {
    first = find_if(first, last, pred);
    if (first == last) return first;
    Iterator result = first;
    for (++first; first != last; ++first) {
        if (!pred(*first)) {
            *result = std::move(*first);
            ++result;
        }
    }
    return result;
}

template <typename InputIt, typename OutputIt, typename T>
OutputIt remove_copy(InputIt first, InputIt last, OutputIt d_first, const T& value) {
    for (; first != last; ++first) {
        if (!(*first == value)) {
            *d_first = *first;
            ++d_first;
        }
    }
    return d_first;
}

template <typename InputIt, typename OutputIt, typename Predicate>
OutputIt remove_copy_if(InputIt first, InputIt last, OutputIt d_first, Predicate pred) {
    for (; first != last; ++first) {
        if (!pred(*first)) {
            *d_first = *first;
            ++d_first;
        }
    }
    return d_first;
}

/* partition_point is lower_bound's shape with a predicate instead of a value:
   it returns the first position for which pred is false, given a range already
   partitioned so that pred holds for a prefix.  qtimezoneprivate_tz.cpp calls
   it on a cbegin()/cend() pair, so random access is available. */
template <typename Iterator, typename Predicate>
Iterator partition_point(Iterator first, Iterator last, Predicate pred) {
    typename iterator_traits<Iterator>::difference_type len = last - first;
    while (len > 0) {
        typename iterator_traits<Iterator>::difference_type half = len / 2;
        Iterator middle = first + half;
        if (pred(*middle)) {
            first = middle + 1;
            len = len - half - 1;
        } else {
            len = half;
        }
    }
    return first;
}

/* Returns first + (last - n_first), which the standard specifies as the
   iterator now occupying the position first held.

   Implemented as three reverses rather than libstdc++'s gcd cycle-leader.
   Both are O(n); the cycle-leader writes each element once where this writes
   each three times, but the reverse form is short enough to verify by eye and
   Qt's call sites (qstring.cpp moving a substring, a couple of small buffer
   rotations) are nowhere near large enough for the constant to matter. */
template <typename Iterator>
Iterator rotate(Iterator first, Iterator n_first, Iterator last) {
    if (n_first == first) return last;
    if (n_first == last) return first;
    reverse(first, n_first);
    reverse(n_first, last);
    reverse(first, last);
    return first + (last - n_first);
}

/* lexicographical_compare is the single most-requested missing algorithm in
   corelib at 1222 sites, because qvector.h, qlist.h, qvarlengtharray.h,
   qstring.h and qpair.h each spell out operator< for their element type in
   terms of it - and every one of those headers is included by hundreds of
   translation units.  The result is that "first range is exhausted and second
   is not", which is the standard's definition of ordering shorter-before-
   longer when all compared elements are equal. */
template <typename InputIt1, typename InputIt2>
bool lexicographical_compare(InputIt1 first1, InputIt1 last1, InputIt2 first2, InputIt2 last2) {
    for (; first1 != last1 && first2 != last2; ++first1, (void)++first2) {
        if (*first1 < *first2) return true;
        if (*first2 < *first1) return false;
    }
    return (first1 == last1) && (first2 != last2);
}

template <typename InputIt1, typename InputIt2, typename Compare>
bool lexicographical_compare(InputIt1 first1, InputIt1 last1,
                             InputIt2 first2, InputIt2 last2, Compare comp) {
    for (; first1 != last1 && first2 != last2; ++first1, (void)++first2) {
        if (comp(*first1, *first2)) return true;
        if (comp(*first2, *first1)) return false;
    }
    return (first1 == last1) && (first2 != last2);
}

/* Three overloads, and the fourth parameter's type is what keeps them apart.

   qglobal.h:1049 calls the three-iterator form through QT_3ARG_ALG, which on
   every compiler but MSVC discards last2 and passes only first2 - hence the
   3-argument version is the one corelib actually needs, 225 times over.

   The four-iterator (C++14) and predicate forms both take four arguments, and
   disambiguating them is the reason the four-iterator one spells its last two
   parameters as the same ForwardIt2 rather than as an independent type: with
   (it, it, it, lambda) deduction of ForwardIt2 fails against the lambda, so
   the predicate form is the only viable one; with (it, it, it, it) both are
   viable but partial ordering prefers the four-iterator form, whose fourth
   parameter is constrained to match its third.  This is exactly how libstdc++
   separates them. */
template <typename ForwardIt1, typename ForwardIt2>
bool is_permutation(ForwardIt1 first1, ForwardIt1 last1, ForwardIt2 first2) {
    /* Skip the common prefix; if the first range is then exhausted the two
       ranges are equal and therefore permutations of each other. */
    for (; first1 != last1; ++first1, (void)++first2) {
        if (!(*first1 == *first2)) break;
    }
    if (first1 == last1) return true;

    ForwardIt2 last2 = first2;
    advance(last2, distance(first1, last1));

    /* Quadratic, and unavoidably so: deciding whether the remainder of the
       second range is a permutation of the first, without extra storage, means
       comparing each distinct value's multiplicity in both.  libstdc++ is
       quadratic here too.  Each distinct value is counted once and then
       skipped on later passes, which is what keeps the common case near n
       rather than n squared. */
    for (ForwardIt1 i = first1; i != last1; ++i) {
        bool seen_earlier = false;
        for (ForwardIt1 j = first1; j != i; ++j) {
            if (*j == *i) { seen_earlier = true; break; }
        }
        if (seen_earlier) continue;

        typename iterator_traits<ForwardIt1>::difference_type c1 = 0;
        typename iterator_traits<ForwardIt2>::difference_type c2 = 0;
        for (ForwardIt1 k = i; k != last1; ++k) {
            if (*k == *i) ++c1;
        }
        for (ForwardIt2 k = first2; k != last2; ++k) {
            if (*k == *i) ++c2;
        }
        if (c1 != c2) return false;
    }
    return true;
}

template <typename ForwardIt1, typename ForwardIt2, typename BinaryPredicate>
bool is_permutation(ForwardIt1 first1, ForwardIt1 last1, ForwardIt2 first2, BinaryPredicate pred) {
    for (; first1 != last1; ++first1, (void)++first2) {
        if (!pred(*first1, *first2)) break;
    }
    if (first1 == last1) return true;

    ForwardIt2 last2 = first2;
    advance(last2, distance(first1, last1));

    for (ForwardIt1 i = first1; i != last1; ++i) {
        bool seen_earlier = false;
        for (ForwardIt1 j = first1; j != i; ++j) {
            if (pred(*j, *i)) { seen_earlier = true; break; }
        }
        if (seen_earlier) continue;

        typename iterator_traits<ForwardIt1>::difference_type c1 = 0;
        typename iterator_traits<ForwardIt2>::difference_type c2 = 0;
        for (ForwardIt1 k = i; k != last1; ++k) {
            if (pred(*k, *i)) ++c1;
        }
        for (ForwardIt2 k = first2; k != last2; ++k) {
            if (pred(*k, *i)) ++c2;
        }
        if (c1 != c2) return false;
    }
    return true;
}

template <typename ForwardIt1, typename ForwardIt2>
bool is_permutation(ForwardIt1 first1, ForwardIt1 last1, ForwardIt2 first2, ForwardIt2 last2) {
    /* Skip the common prefix, bounded by both ranges.  A mismatch here means
       only that the prefix is exhausted - it says nothing about whether the
       remainders are permutations of each other, so this breaks out of the
       loop and lets the count below decide.

       Returning false at this point is wrong and was the bug in the first
       version: {1,2,3,4} against {4,3,2,1} mismatches on the very first
       element and is a permutation.  It also produces the right answer for the
       wrong reason on genuinely unequal ranges, so it can pass a test that
       only checks negative cases. */
    for (; first1 != last1 && first2 != last2; ++first1, (void)++first2) {
        if (!(*first1 == *first2)) break;
    }
    /* Differing lengths cannot be permutations of each other.  Checked after
       the skip, so it compares what is left rather than the whole ranges. */
    return distance(first1, last1) == distance(first2, last2)
        && is_permutation(first1, last1, first2);
}

template <typename InputIt1, typename InputIt2, typename OutputIt>
OutputIt set_intersection(InputIt1 first1, InputIt1 last1,
                          InputIt2 first2, InputIt2 last2, OutputIt d_first) {
    while (first1 != last1 && first2 != last2) {
        if (*first1 < *first2) {
            ++first1;
        } else if (*first2 < *first1) {
            ++first2;
        } else {
            *d_first = *first1;
            ++d_first;
            ++first1;
            ++first2;
        }
    }
    return d_first;
}

template <typename InputIt1, typename InputIt2, typename OutputIt, typename Compare>
OutputIt set_intersection(InputIt1 first1, InputIt1 last1,
                          InputIt2 first2, InputIt2 last2, OutputIt d_first, Compare comp) {
    while (first1 != last1 && first2 != last2) {
        if (comp(*first1, *first2)) {
            ++first1;
        } else if (comp(*first2, *first1)) {
            ++first2;
        } else {
            *d_first = *first1;
            ++d_first;
            ++first1;
            ++first2;
        }
    }
    return d_first;
}

template <typename InputIt1, typename InputIt2, typename OutputIt>
OutputIt set_union(InputIt1 first1, InputIt1 last1,
                   InputIt2 first2, InputIt2 last2, OutputIt d_first) {
    while (first1 != last1 && first2 != last2) {
        if (*first1 < *first2) {
            *d_first = *first1;
            ++first1;
        } else if (*first2 < *first1) {
            *d_first = *first2;
            ++first2;
        } else {
            /* Equal: emit once, consume from both. */
            *d_first = *first1;
            ++first1;
            ++first2;
        }
        ++d_first;
    }
    /* Whichever range is left over gets appended; the inner copy runs to
       completion before the outer one starts, so the returned iterator is the
       right destination either way. */
    return copy(first2, last2, copy(first1, last1, d_first));
}

/* Both ranges sorted; true when every element of the second is present in the
   first.  qshaderformat.cpp:113 is the caller:

       std::includes(m_extensions.constBegin(), m_extensions.constEnd(),
                     other.m_extensions.constBegin(), other.m_extensions.constEnd());

   on a QByteArrayList, that is QList<QByteArray>.  The two ranges get
   independent template parameters rather than one shared InputIt: constBegin()
   and constEnd() happen to agree on QList, but that is a container detail and
   not something [alg.set.operations] asks the caller to guarantee.

   Single pass over both.  A first-range element sorting before the current
   second-range element cannot match it and is skipped; one sorting after it
   means the second range holds a value the first does not, which is the whole
   question includes() answers. */
template <typename InputIt1, typename InputIt2>
bool includes(InputIt1 first1, InputIt1 last1, InputIt2 first2, InputIt2 last2) {
    for (; first2 != last2; ++first1) {
        if (first1 == last1 || *first2 < *first1) return false;
        if (!(*first1 < *first2)) ++first2;
    }
    return true;
}

template <typename InputIt1, typename InputIt2, typename Compare>
bool includes(InputIt1 first1, InputIt1 last1, InputIt2 first2, InputIt2 last2, Compare comp) {
    for (; first2 != last2; ++first1) {
        if (first1 == last1 || comp(*first2, *first1)) return false;
        if (!comp(*first1, *first2)) ++first2;
    }
    return true;
}

/* The braced-list forms of max() and min().  qktxhandler.cpp:193 is the caller:

       qCountLeadingZeroBits(std::max({ header.pixelWidth, header.pixelHeight,
                                        header.pixelDepth }))

   all three fields being quint32, so initializer_list<T> deduces cleanly.

   Written as a loop rather than as max_element(ilist.begin(), ilist.end()) even
   though that is the textbook definition.  max_element is declared further down
   this header, and calling it from here would not compile: the lookup is
   dependent, so it considers only declarations visible at the point of
   definition plus whatever ADL finds at instantiation, and ADL on `const
   quint32*` associates no namespace containing it.  Moving these four overloads
   below max_element instead would separate them from the two-argument max()
   directly above, which costs the next reader more than the loop costs.

   The returned reference points into the initializer_list's backing array,
   whose lifetime reaches the end of the full-expression - long enough for the
   call site above, and the same rule the standard gives.  An empty list is
   undefined behaviour there and dereferences begin() here; the return type is a
   reference, so there is no way to report it. */
template <typename T>
const T& max(initializer_list<T> ilist) {
    const T* best = ilist.begin();
    for (const T* p = best + 1; p != ilist.end(); ++p) {
        if (*best < *p) best = p;
    }
    return *best;
}

template <typename T, typename Compare>
const T& max(initializer_list<T> ilist, Compare comp) {
    const T* best = ilist.begin();
    for (const T* p = best + 1; p != ilist.end(); ++p) {
        if (comp(*best, *p)) best = p;
    }
    return *best;
}

template <typename T>
const T& min(initializer_list<T> ilist) {
    const T* best = ilist.begin();
    for (const T* p = best + 1; p != ilist.end(); ++p) {
        if (*p < *best) best = p;
    }
    return *best;
}

template <typename T, typename Compare>
const T& min(initializer_list<T> ilist, Compare comp) {
    const T* best = ilist.begin();
    for (const T* p = best + 1; p != ilist.end(); ++p) {
        if (comp(*p, *best)) best = p;
    }
    return *best;
}

template <typename InputIt1, typename InputIt2, typename OutputIt, typename Compare>
OutputIt set_union(InputIt1 first1, InputIt1 last1,
                   InputIt2 first2, InputIt2 last2, OutputIt d_first, Compare comp) {
    while (first1 != last1 && first2 != last2) {
        if (comp(*first1, *first2)) {
            *d_first = *first1;
            ++first1;
        } else if (comp(*first2, *first1)) {
            *d_first = *first2;
            ++first2;
        } else {
            *d_first = *first1;
            ++first1;
            ++first2;
        }
        ++d_first;
    }
    return copy(first2, last2, copy(first1, last1, d_first));
}

/**
 * inplace_merge / stable_partition.
 *
 * Both are here, at the bottom of the header, on purpose: they call rotate(),
 * which is defined at line ~889.  A dependent call inside a template only sees
 * declarations that exist at the point of definition (plus whatever ADL finds),
 * and ADL on a raw pointer or on QVector's iterator associates no namespace that
 * contains rotate - so placing these any earlier would compile to "rotate was
 * not declared in this scope" at instantiation, far from the real cause.
 *
 * Why Qt needs them:
 *   qgraphicsscenelinearindex_p.h:99 (a header, so it takes two widgets TUs down)
 *     std::inplace_merge(m_items.begin(),
 *                        m_items.begin() + m_numSortedElements,
 *                        m_items.end());
 *   on a QList<QGraphicsItem*>, immediately after std::sort() of the tail.
 *
 *   qmdiarea.cpp:490
 *     const auto firstOut = std::stable_partition(source.begin(), source.end(),
 *                                                containedInDomain);
 *   on a QVector<QRect>, with the result used as a split point for a
 *   back_inserter copy and then source.erase(firstOut, source.end()).
 */

/**
 * Merge two consecutive sorted ranges in place.
 *
 * [first, middle) and [middle, last) are each already sorted; afterwards the
 * whole of [first, last) is sorted.  The standard's complexity bound is at most
 * (last - first) - 1 comparisons when enough memory is available, and the buffer
 * version below hits exactly that.
 *
 * `comp(*right, *left)` rather than `comp(*left, *right)` is what makes this
 * stable: an element from the left range is taken on a tie, so equal elements
 * keep their relative order.  Getting that backwards compiles fine and silently
 * breaks the stability guarantee, which is the only reason the whole function
 * exists instead of just calling sort() again.
 *
 * The writeback uses MoveAssignable (`first[j] = static_cast<value_type&&>(...)`)
 * because that is precisely what [alg.merge] requires of T - it does not ask for
 * CopyAssignable, and requiring it here would break types like unique_ptr that
 * the rest of this STL goes out of its way to support.
 *
 * On allocation failure this returns leaving the range untouched.  Sorting
 * algorithms in this header have no way to report failure (no exceptions, and
 * the return type is void), so "unchanged" is chosen over "half merged", which
 * would corrupt a range the caller believes is sorted.
 */
template <typename Iterator, typename Compare>
void inplace_merge(Iterator first, Iterator middle, Iterator last, Compare comp) {
    typedef typename iterator_traits<Iterator>::value_type value_type;

    size_t n = (size_t)(last - first);
    if (n < 2 || first == middle || middle == last) {
        return;
    }

    value_type* temp = (value_type*)malloc(n * sizeof(value_type));
    if (!temp) {
        return;
    }

    Iterator left = first;
    Iterator right = middle;
    size_t i = 0;
    while (left != middle && right != last) {
        if (comp(*right, *left)) {
            new (&temp[i++]) value_type(static_cast<value_type&&>(*right));
            ++right;
        } else {
            new (&temp[i++]) value_type(static_cast<value_type&&>(*left));
            ++left;
        }
    }
    /* Exactly one of these two runs; both are needed because whichever range
       still has leftovers has them already in order. */
    while (left != middle) {
        new (&temp[i++]) value_type(static_cast<value_type&&>(*left));
        ++left;
    }
    while (right != last) {
        new (&temp[i++]) value_type(static_cast<value_type&&>(*right));
        ++right;
    }

    for (size_t j = 0; j < n; j++) {
        first[j] = static_cast<value_type&&>(temp[j]);
        temp[j].~value_type();
    }
    free(temp);
}

template <typename Iterator>
void inplace_merge(Iterator first, Iterator middle, Iterator last) {
    inplace_merge(first, middle, last, ewok_sort_detail::default_less());
}

/**
 * Allocation-free stable_partition, used only when malloc fails.
 *
 * O(n^2) element moves, but correct and stable: each time an element satisfying
 * pred is found at `it`, rotate() moves it to the front of the not-yet-classified
 * region without disturbing the order of anything it passes over.  `boundary`
 * always points at the first element that is not known to satisfy pred.
 *
 * Declared before stable_partition() below because that one calls it, and see the
 * note at the top of this section about dependent names.
 */
template <typename Iterator, typename Predicate>
Iterator stable_partition_inplace(Iterator first, Iterator last, Predicate pred) {
    Iterator boundary = first;
    for (Iterator it = first; it != last; ) {
        if (pred(*it)) {
            if (it != boundary) {
                rotate(boundary, it, it + 1);
            }
            ++boundary;
        }
        ++it;
    }
    return boundary;
}

/**
 * Reorder so that every element satisfying pred precedes every element that does
 * not, preserving the relative order within each group, and return an iterator to
 * the first element of the second group.
 *
 * Exactly one call to pred per element, which matters because qmdiarea's predicate
 * is a QRect::contains() lambda - cheap, but callers are entitled to assume this.
 *
 * Single pass into a temporary: satisfying elements are laid down from the front
 * (temp[0..]), the rest from the back (temp[n-1..]).  The back group therefore
 * ends up in reverse order of appearance and is written back reversed, which
 * restores its original order.  Both groups stay stable, and only one traversal
 * of the source is needed.
 *
 * Worked example - pred true for a and c in [a, b, c, d]:
 *   temp becomes [a, c, d, b] with lo = 2
 *   front writeback  first[0]=a, first[1]=c
 *   back  writeback  first[2]=temp[3]=b, first[3]=temp[2]=d
 *   result [a, c, b, d], returns first + 2
 */
template <typename Iterator, typename Predicate>
Iterator stable_partition(Iterator first, Iterator last, Predicate pred) {
    typedef typename iterator_traits<Iterator>::value_type value_type;

    if (first == last) {
        return first;
    }
    size_t n = (size_t)(last - first);

    value_type* temp = (value_type*)malloc(n * sizeof(value_type));
    if (!temp) {
        return stable_partition_inplace(first, last, pred);
    }

    size_t lo = 0;
    size_t hi = n;
    for (Iterator it = first; it != last; ++it) {
        if (pred(*it)) {
            new (&temp[lo++]) value_type(static_cast<value_type&&>(*it));
        } else {
            new (&temp[--hi]) value_type(static_cast<value_type&&>(*it));
        }
    }

    for (size_t j = 0; j < lo; j++) {
        first[j] = static_cast<value_type&&>(temp[j]);
        temp[j].~value_type();
    }
    for (size_t j = 0; j < n - lo; j++) {
        first[lo + j] = static_cast<value_type&&>(temp[n - 1 - j]);
        temp[n - 1 - j].~value_type();
    }
    free(temp);

    return first + lo;
}

