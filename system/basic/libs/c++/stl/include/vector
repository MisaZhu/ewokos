#ifndef EWOK_STL_VECTOR_H
#define EWOK_STL_VECTOR_H

#include "iterator"
#include <stdlib.h>

/* Placement operator new/delete used to be declared here, at global scope, in a
   container header.  They live in <new> now, which is where the standard puts
   them and which also brings the nothrow forms. */
#include <new>

namespace std {

template <typename T>
static inline T* vector_alloc_buffer(size_t count) {
    if (count == 0) {
        return nullptr;
    }
    return (T*)malloc(sizeof(T) * count);
}

/**
 * @class vector
 * This class represents a dynamic contiguous array
 */
template <typename T, typename Alloc = void>
class vector {
    public:
        /* The value-type family was missing entirely: vector declared only the four
           iterator typedefs below.  Anything generic that names Container::value_type
           therefore failed to compile, and Qt has a lot of that - std::back_inserter
           alone appears 43 times, and its operator= is declared as

               back_insert_iterator& operator=(const typename Container::value_type&);

           which is instantiated the moment the adaptor is, giving
           "no type named 'value_type' in 'class std::vector<RectF>'".  These are the
           names the standard requires of every container, so they are added as a set
           rather than one at a time as each breaks. */
        typedef T value_type;
        typedef T& reference;
        typedef const T& const_reference;
        typedef T* pointer;
        typedef const T* const_pointer;
        typedef size_t size_type;
        typedef ptrdiff_t difference_type;

        typedef random_access_iterator<T> iterator;
        typedef const_random_access_iterator<T> const_iterator;
        typedef std::reverse_iterator<iterator> reverse_iterator;
        typedef std::reverse_iterator<const_iterator> const_reverse_iterator;

        /**
         * Default constructor
         * Initializes everything to 0
         */
        vector();

        /**
         * Fill constructor
         * Constructs a container with n elements. Each element is a copy of val
         * @param n The number of elements
         * @param val The value to fill the vector with
         *
         * Two overloads rather than one with a defaulted second parameter.  The
         * old `vector(size_t n, const T& val = T())` filled by copying val, so
         * even the one-argument form required T to be copy constructible - which
         * makes vector<std::unique_ptr<X>> unusable, because merely declaring a
         * resize or a fill construction instantiates that copy and hits the
         * deleted copy constructor.  The n-only overload value-initializes
         * instead, which is also what the standard specifies for it.
         */
        vector(size_t n);
        vector(size_t n, const T& val);

        /**
         * Range constructor
         * Constructs a container with as many elements as the range [first, last), with each element
         * constructed from its corresponding element in that range, in the same order
         * @param first An iterator specifying the first position of the element in the range of elements
         * @param last An iterator specifying the last, non-inclusive position of the element in the range of elements
         */
        vector(iterator first, iterator last);

        /**
         * Copy constructor
         * @param src The vector to copy
         */
        vector(const vector<T, Alloc>& src);

        /**
         * Move constructor / move assignment.
         *
         * Without these a vector is not MoveConstructible, and everything that
         * assumes it is falls back to copying: std::swap in <utility> is
         * implemented as three moves, so swapping two vector<unique_ptr<X>>
         * instantiated the copy constructor and hit `use of deleted function`.
         * Both are O(1) - the move constructor steals the buffer, the move
         * assignment swaps, which also leaves the old elements to be freed by
         * the source's destructor.
         * @param src The vector to take ownership from
         */
        vector(vector<T, Alloc>&& src);

        /**
         * Destructor
         * Frees the vector
         */
        ~vector();

        /**
         * Assignment operator
         * @param rhs The vector to assign to this one
         */
        vector<T, Alloc>& operator=(const vector& rhs);
        vector<T, Alloc>& operator=(vector<T, Alloc>&& rhs);

        /**
         * Return the iterator at the beginning of the vector
         */
        iterator begin();
        
        /**
         * Return a constant iterator at the beginning of the vector
         */
        const_iterator begin() const;

        /**
         * Return an iterator referring to the past-the-end element in the vector
         */
        iterator end();

        /**
         * Return a constant iterator referring to the past-the-end element in the vector
         */
        const_iterator end() const;

        /**
         * Return constant iterators.  qmimedata.cpp calls cend() on a const
         * vector<QMimeDataStruct>; cbegin/cend are also the only way to obtain a
         * const_iterator from a non-const container, so both halves are needed
         * even though only cend was reported missing.
         */
        const_iterator cbegin() const;
        const_iterator cend() const;

        /**
         * Return a reverse iterator at the beginning of the reversed vector
         */
        reverse_iterator rbegin();

        /**
         * Return a constant reverse iterator at the beginning of the reversed vector
         */
        const_reverse_iterator rbegin() const;

        /**
         * Return a reverse iterator at the end of the reversed vector
         */
        reverse_iterator rend();

        /**
         * Return a constant reverse iterator at the end of the reversed vector
         */
        const_reverse_iterator rend() const;

        /**
         * Return a reference to the first element in the vector
         */
        T& front();

        /**
         * Return a constant reference to the first element in the vector
         */
        const T& front() const;

        /**
         * Return a reference to the last element in the vector
         */
        T& back();

        /**
         * Return a constant reference to the last element in the vector
         */
        const T& back() const;

        size_t size() const { return length_; }
        size_t capacity() const { return capacity_; }
        bool empty() const { return length_ == 0; }

        /**
         * Resize the vector. This reallocates memory to the array only if the requested size is greater than the vector's
         * current capacity.
         * @param n The new size of the vector
         * @param val The value to copy at the end of the vector, in case the new size is larger than our array's
         *
         * Split in two for the same reason as the fill constructor above: the old
         * `resize(size_t n, T val = T())` took val *by value* and copy constructed
         * every appended element from it, so resize(n) on a move-only element type
         * failed to compile.  The n-only form now value-initializes, and the
         * two-argument form takes val by const reference as the standard has it.
         */
        void resize(size_t n);
        void resize(size_t n, const T& val);

        /**
         * Reserve memory for the vector. This reallocates memory to the array only if the requested capacity is greater than
         * the current one. This function does not modify the vector's elements
         * @param n The new capacity the we want for this vector
         */
        void reserve(size_t n);

        /**
         * Access element
         * @param n The position at which we want to access the element
         */
        T& operator[](size_t n);
        const T& operator[](size_t n) const;

        /**
         * Returns a reference to the element at position n in the vector
         * @param n The position at which we want to access the element
         */
        T& at(size_t n);
        const T& at(size_t n) const;

        /**
         * Assign a new content to the vector by specifying a range of values from two iterators
         * @param first The first element to consider in the range
         * @param last The last, non-inclusive element to consider in the range
         */
        void assign(iterator first, iterator last);

        /**
         * Fill the vector with a value
         * @param n The new size for the vector
         * @param val Value to fill the vector with
         */
        void assign(size_t n, const T& val);

        /**
         * Add an element at the end of the vector
         * @param val The value to add at the end
         */
        void push_back(const T& val);

        /**
         * Add an element at the end of the vector (move version)
         * @param val The value to add at the end
         */
        void push_back(T&& val);

        /**
         * Construct and add an element at the end of the vector
         * @param args Arguments to construct the element
         */
        template <typename... Args>
        void emplace_back(Args&&... args);

        /**
         * Remove the last element of the vector
         */
        void pop_back();

        /**
         * Insert a single element in the vector
         * @param position An iterator specifying the position at which to insert the element
         * @param val The value of the element to insert
         * @return An iterator that points to the first of the newly inserted elements
         */
        iterator insert(iterator position, const T& val);

        /**
         * Insert several elements in the vector
         * @param position An iterator specifying the position at which to insert the elements
         * @param n The number of elements to insert
         * @param val The value of the element to insert
         * @return An iterator that points to the first of the newly inserted elements
         */
        iterator insert(iterator position, size_t n, const T& val);

        /** Insert a range of elements from two iterators in the vector
        * @param position An iterator specifying the position at which to insert the range of elements
        * @param first An iterator representing the first element in the range of elements to insert
        * @param last An iterator representing the last, non-inclusive element in the range of elements to insert
        * @return An iterator that points to the first of the newly inserted elements
        */
        iterator insert(iterator position, iterator first, iterator last);

        /**
         * Erase an element from the vector
         * @param position An iterator specifying the position at which to remove the element
         * @return An iterator poiting to the new location of the element that followed the last element erased
         */
        iterator erase(iterator position);

        /**
         * Erase a range of elements from the vector
         * @param first An iterator representing the first position of the range in the vector
         * @param last An iterator representing the last, non-inclusive position of the range in the vector
         * @return An iterator poiting to the new location of the element that followed the last element erased
         */
        iterator erase(iterator first, iterator last);

        /**
         * Clear the vector. This frees the allocated memory
         */
        void clear();

        /**
         * Swap the contents with another vector in O(1) (pointer exchange).
         * Enables cheap move construction/assignment for element types.
         */
        void swap(vector& other);

    private:
        /* Ensures capacity_ is at least n, moving the existing elements into the
           new storage.  Shared by both resize overloads so that the growth policy
           is written once; returns false if the allocation failed, leaving the
           vector untouched.  Not part of the standard's interface. */
        bool grow_to(size_t n);
        T*          data_;      /**< The contiguous dynamic array */
        size_t      length_;    /**< The length of the array */
        size_t      capacity_;  /**< The capacity of the array */
};

template <typename T, typename Alloc>
vector<T, Alloc>::vector() : data_(nullptr), length_(0), capacity_(0) {
    data_ = vector_alloc_buffer<T>(4);
    if (data_) {
        capacity_ = 4;
    }
}

template <typename T, typename Alloc>
vector<T, Alloc>::vector(size_t n) : length_(n), capacity_(n * 2) {
    if (capacity_ == 0) capacity_ = 1;
    data_ = vector_alloc_buffer<T>(capacity_);
    if (!data_) {
        length_ = 0;
        capacity_ = 0;
        return;
    }
    for (size_t i = 0; i < length_; i++) {
        new (&data_[i]) T();
    }
}

template <typename T, typename Alloc>
vector<T, Alloc>::vector(size_t n, const T& val) : length_(n), capacity_(n * 2) {
    if (capacity_ == 0) capacity_ = 1;
    data_ = vector_alloc_buffer<T>(capacity_);
    if (!data_) {
        length_ = 0;
        capacity_ = 0;
        return;
    }
    for (size_t i = 0; i < length_; i++) {
        new (&data_[i]) T(val);
    }
}

template <typename T, typename Alloc>
vector<T, Alloc>::vector(iterator first, iterator last) {
    length_ = last - first;
    capacity_ = length_ * 2;
    if (capacity_ == 0) {
        capacity_ = 1;
    }
    data_ = vector_alloc_buffer<T>(capacity_);
    if (!data_) {
        length_ = 0;
        capacity_ = 0;
        return;
    }

    for (size_t i = 0; first != last; ++first, i++) {
        new (&data_[i]) T(*first);
    }
}

template <typename T, typename Alloc>
vector<T, Alloc>::vector(const vector<T, Alloc>& src) {
    length_ = src.length_;
    capacity_ = src.capacity_;
    data_ = vector_alloc_buffer<T>(capacity_);
    if (!data_) {
        length_ = 0;
        capacity_ = 0;
        return;
    }

    for (size_t i = 0; i < length_; i++) {
        new (&data_[i]) T(src.data_[i]);
    }
}

template <typename T, typename Alloc>
vector<T, Alloc>::vector(vector<T, Alloc>&& src)
    : data_(src.data_), length_(src.length_), capacity_(src.capacity_) {
    src.data_ = nullptr;
    src.length_ = 0;
    src.capacity_ = 0;
}

template <typename T, typename Alloc>
vector<T, Alloc>::~vector() {
    clear();
    free(data_);
}

template <typename T, typename Alloc>
vector<T, Alloc>& vector<T, Alloc>::operator=(vector<T, Alloc>&& rhs) {
    if (this != &rhs) {
        swap(rhs);
    }
    return *this;
}

template <typename T, typename Alloc>
vector<T, Alloc>& vector<T, Alloc>::operator=(const vector& rhs) {
    if (this != &rhs) {
        size_t newLength = rhs.length_;
        size_t newCapacity = rhs.capacity_;
        T* newData = vector_alloc_buffer<T>(newCapacity);
        if (!newData && newCapacity != 0) {
            return *this;
        }
        for (size_t i = 0; i < newLength; i++) {
            new (&newData[i]) T(rhs.data_[i]);
        }
        clear();
        free(data_);
        length_ = newLength;
        capacity_ = newCapacity;
        data_ = newData;
    }

    return *this;
}

template <typename T, typename Alloc>
typename vector<T, Alloc>::iterator vector<T, Alloc>::begin() {
    return iterator(data_);
}

template <typename T, typename Alloc>
typename vector<T, Alloc>::const_iterator vector<T, Alloc>::begin() const {
    return const_iterator(data_);
}

template <typename T, typename Alloc>
typename vector<T, Alloc>::iterator vector<T, Alloc>::end() {
    return iterator(data_ + length_);
}

template <typename T, typename Alloc>
typename vector<T, Alloc>::const_iterator vector<T, Alloc>::end() const {
    return const_iterator(data_ + length_);
}

template <typename T, typename Alloc>
typename vector<T, Alloc>::const_iterator vector<T, Alloc>::cbegin() const {
    return const_iterator(data_);
}

template <typename T, typename Alloc>
typename vector<T, Alloc>::const_iterator vector<T, Alloc>::cend() const {
    return const_iterator(data_ + length_);
}

template <typename T, typename Alloc>
typename vector<T, Alloc>::reverse_iterator vector<T, Alloc>::rbegin() {
    return reverse_iterator(end());
}

template <typename T, typename Alloc>
typename vector<T, Alloc>::const_reverse_iterator vector<T, Alloc>::rbegin() const {
    return const_reverse_iterator(end());
}

template <typename T, typename Alloc>
typename vector<T, Alloc>::reverse_iterator vector<T, Alloc>::rend() {
    return reverse_iterator(begin());
}

template <typename T, typename Alloc>
typename vector<T, Alloc>::const_reverse_iterator vector<T, Alloc>::rend() const {
    return const_reverse_iterator(begin());
}

template <typename T, typename Alloc>
T& vector<T, Alloc>::front() {
    return data_[0];
}

template <typename T, typename Alloc>
const T& vector<T, Alloc>::front() const {
    return data_[0];
}

template <typename T, typename Alloc>
T& vector<T, Alloc>::back() {
    return data_[length_ - 1];
}

template <typename T, typename Alloc>
const T& vector<T, Alloc>::back() const {
    return data_[length_ - 1];
}

template <typename T, typename Alloc>
bool vector<T, Alloc>::grow_to(size_t n) {
    if (n <= capacity_) {
        return true;
    }
    size_t newCapacity = n * 2;
    T* newData = vector_alloc_buffer<T>(newCapacity);
    if (!newData) {
        return false;
    }
    for (size_t i = 0; i < length_; i++) {
        new (&newData[i]) T(static_cast<T&&>(data_[i]));
        data_[i].~T();
    }

    free(data_);
    data_ = newData;
    capacity_ = newCapacity;
    return true;
}

template <typename T, typename Alloc>
void vector<T, Alloc>::resize(size_t n) {
    if (n < length_) {
        for (size_t i = n; i < length_; i++) {
            data_[i].~T();
        }
        length_ = n;
    } else if (n > length_) {
        if (!grow_to(n)) {
            return;
        }
        for (size_t i = length_; i < n; i++) {
            new (&data_[i]) T();
        }
        length_ = n;
    }
}

template <typename T, typename Alloc>
void vector<T, Alloc>::resize(size_t n, const T& val) {
    if (n < length_) {
        for (size_t i = n; i < length_; i++) {
            data_[i].~T();
        }
        length_ = n;
    } else if (n > length_) {
        if (!grow_to(n)) {
            return;
        }
        for (size_t i = length_; i < n; i++) {
            new (&data_[i]) T(val);
        }
        length_ = n;
    }
}

template <typename T, typename Alloc>
void vector<T, Alloc>::reserve(size_t n) {
    if (n > capacity_) {
        T* newData = vector_alloc_buffer<T>(n);
        if (!newData) {
            return;
        }
        for (size_t i = 0; i < length_; i++) {
            new (&newData[i]) T(static_cast<T&&>(data_[i]));
            data_[i].~T();
        }

        free(data_);
        data_ = newData;
        capacity_ = n;
    }
}

template <typename T, typename Alloc>
T& vector<T, Alloc>::operator[](size_t n) {
    return data_[n];
}

template <typename T, typename Alloc>
const T& vector<T, Alloc>::operator[](size_t n) const {
    return data_[n];
}

template <typename T, typename Alloc>
T& vector<T, Alloc>::at(size_t n) {
    return data_[n];
}

template <typename T, typename Alloc>
const T& vector<T, Alloc>::at(size_t n) const {
    return data_[n];
}

template <typename T, typename Alloc>
void vector<T, Alloc>::assign(iterator first, iterator last) {
    clear();

    length_ = last - first;
    reserve(length_ * 2);

    for (size_t i = 0; first != last; ++first, i++) {
        new (&data_[i]) T(*first);
    }
}

template <typename T, typename Alloc>
void vector<T, Alloc>::assign(size_t n, const T& val) {
    clear();
    reserve(n * 2);

    for (size_t i = 0; i < n; i++) {
        new (&data_[i]) T(val);
    }

    length_ = n;
}

template <typename T, typename Alloc>
void vector<T, Alloc>::push_back(const T& val) {
	if (length_ + 1 >= capacity_) {
		size_t newCapacity = capacity_ ? capacity_ * 2 : 4;
		T* newData = vector_alloc_buffer<T>(newCapacity);
		if (!newData) {
			return;
		}
		for (size_t i = 0; i < length_; i++) {
			new (&newData[i]) T(static_cast<T&&>(data_[i]));
			data_[i].~T();
		}

		free(data_);
		data_ = newData;
		capacity_ = newCapacity;
	}

	new (&data_[length_]) T(val);
	length_++;
}

template <typename T, typename Alloc>
void vector<T, Alloc>::push_back(T&& val) {
	if (length_ + 1 >= capacity_) {
		size_t newCapacity = capacity_ ? capacity_ * 2 : 4;
		T* newData = vector_alloc_buffer<T>(newCapacity);
		if (!newData) {
			return;
		}
		for (size_t i = 0; i < length_; i++) {
			new (&newData[i]) T(static_cast<T&&>(data_[i]));
			data_[i].~T();
		}

		free(data_);
		data_ = newData;
		capacity_ = newCapacity;
	}

	new (&data_[length_]) T(static_cast<T&&>(val));
	length_++;
}

template <typename T, typename Alloc>
template <typename... Args>
void vector<T, Alloc>::emplace_back(Args&&... args) {
	if (length_ + 1 >= capacity_) {
		size_t newCapacity = capacity_ ? capacity_ * 2 : 4;
		T* newData = vector_alloc_buffer<T>(newCapacity);
		if (!newData) {
			return;
		}
		for (size_t i = 0; i < length_; i++) {
			new (&newData[i]) T(static_cast<T&&>(data_[i]));
			data_[i].~T();
		}

		free(data_);
		data_ = newData;
		capacity_ = newCapacity;
	}

	new (&data_[length_]) T(static_cast<Args&&>(args)...);
	length_++;
}

template <typename T, typename Alloc>
void vector<T, Alloc>::pop_back() {
    if (length_ > 0) {
        length_ -= 1;
        data_[length_].~T();
    }
}

template <typename T, typename Alloc>
typename vector<T, Alloc>::iterator vector<T, Alloc>::insert(iterator position, const T& val) {
    size_t pos = length_;
    if (position.ptr_ != nullptr && length_ > 0) {
        pos = ((size_t)position.ptr_ - (size_t)data_) / sizeof(T);
        if (pos > length_) pos = length_;
    }

    if (length_ + 1 > capacity_) {
        size_t oldLength = length_;
        size_t newCapacity = (length_ + 1) * 2;
        T* newData = vector_alloc_buffer<T>(newCapacity);
        if (!newData) {
            return begin() + pos;
        }

        for (size_t i = 0; i < length_; i++) {
            new (&newData[i]) T(static_cast<T&&>(data_[i]));
            data_[i].~T();
        }

        free(data_);
        data_ = newData;
        capacity_ = newCapacity;
        length_ = oldLength;
    }

    for (size_t i = length_; i > pos; i--) {
        new (&data_[i]) T(static_cast<T&&>(data_[i-1]));
        data_[i-1].~T();
    }
    // Use placement new instead of assignment to avoid issues with uninitialized memory
    new (&data_[pos]) T(val);
    length_ += 1;

    return begin() + pos;
}

template <typename T, typename Alloc>
typename vector<T, Alloc>::iterator vector<T, Alloc>::insert(iterator position, size_t n, const T& val) {
    size_t pos = length_;
    if (position.ptr_ != nullptr && length_ > 0) {
        pos = ((size_t)position.ptr_ - (size_t)data_) / sizeof(T);
        if (pos > length_) pos = length_;
    }

    if (length_ + n > capacity_) {
        size_t oldLength = length_;
        size_t newCapacity = length_ + n;
        T* newData = vector_alloc_buffer<T>(newCapacity);
        if (!newData) {
            return begin() + pos;
        }

        for (size_t i = 0; i < length_; i++) {
            new (&newData[i]) T(static_cast<T&&>(data_[i]));
            data_[i].~T();
        }

        free(data_);
        data_ = newData;
        capacity_ = newCapacity;
        length_ = oldLength;
    }

    for (size_t i = length_ + n - 1; i >= pos + n; i--) {
        new (&data_[i]) T(static_cast<T&&>(data_[i - n]));
        data_[i - n].~T();
    }

    for (size_t i = pos; i < pos + n; i++) {
        new (&data_[i]) T(val);
    }

    length_ += n;

    return begin() + pos;
}

template <typename T, typename Alloc>
typename vector<T, Alloc>::iterator vector<T, Alloc>::insert(iterator position, iterator first, iterator last) {
    size_t pos = length_;
    size_t size = 0;

    if (position.ptr_ != nullptr && length_ > 0) {
        pos = ((size_t)position.ptr_ - (size_t)data_) / sizeof(T);
        if (pos > length_) pos = length_;
    }

    for (iterator it = first; it != last; ++it) {
        size++;
    }

    if (length_ + size > capacity_) {
        size_t oldLength = length_;
        size_t newCapacity = length_ + size;
        T* newData = vector_alloc_buffer<T>(newCapacity);
        if (!newData) {
            return begin() + pos;
        }

        for (size_t i = 0; i < length_; i++) {
            new (&newData[i]) T(static_cast<T&&>(data_[i]));
            data_[i].~T();
        }

        free(data_);
        data_ = newData;
        capacity_ = newCapacity;
        length_ = oldLength;
    }

    for (size_t i = length_ + size - 1; i >= pos + size; i--) {
        new (&data_[i]) T(static_cast<T&&>(data_[i - size]));
        data_[i - size].~T();
    }

    for (size_t i = pos, idx = 0; first != last; ++first, i++, idx++) {
        new (&data_[i]) T(*first);
    }

    length_ += size;

    return begin() + pos;
}

template <typename T, typename Alloc>
typename vector<T, Alloc>::iterator vector<T, Alloc>::erase(iterator position) {
    if (length_ == 0) return begin();

    size_t pos = 0;
    if (position.ptr_ != nullptr) {
        pos = ((size_t)position.ptr_ - (size_t)data_) / sizeof(T);
        if (pos >= length_) pos = length_ - 1;
    }

    // Move elements to fill the gap
    for (size_t i = pos; i < length_ - 1; i++) {
        // Use placement new with move assignment instead of destruct-then-construct
        data_[i] = static_cast<T&&>(data_[i + 1]);
    }
    // Destroy the last element (which was moved from)
    if (length_ > 0) {
        data_[length_ - 1].~T();
    }
    length_ -= 1;

    return begin() + pos;
}

template <typename T, typename Alloc>
typename vector<T, Alloc>::iterator vector<T, Alloc>::erase(iterator first, iterator last) {
    if (length_ == 0) return begin();

    size_t pos = 0;
    size_t endPos = length_;

    if (first.ptr_ != nullptr) {
        pos = ((size_t)first.ptr_ - (size_t)data_) / sizeof(T);
        if (pos > length_) pos = length_;
    }

    if (last.ptr_ != nullptr) {
        endPos = ((size_t)last.ptr_ - (size_t)data_) / sizeof(T);
        if (endPos > length_) endPos = length_;
    }

    if (pos > endPos) pos = endPos;

    size_t diff = endPos - pos;

    // Move elements to fill the gap
    for (size_t i = pos; i < length_ - diff; i++) {
        data_[i] = static_cast<T&&>(data_[i + diff]);
    }

    // Destroy the moved-from elements at the end
    for (size_t i = length_ - diff; i < length_; i++) {
        data_[i].~T();
    }

    length_ -= diff;

    return begin() + pos;
}

template <typename T, typename Alloc>
void vector<T, Alloc>::clear() {
    for (size_t i = 0; i < length_; i++) {
        data_[i].~T();
    }
    length_ = 0;
}

template <typename T, typename Alloc>
void vector<T, Alloc>::swap(vector& other) {
    T* tmpData = data_;
    size_t tmpLength = length_;
    size_t tmpCapacity = capacity_;
    data_ = other.data_;
    length_ = other.length_;
    capacity_ = other.capacity_;
    other.data_ = tmpData;
    other.length_ = tmpLength;
    other.capacity_ = tmpCapacity;
}

