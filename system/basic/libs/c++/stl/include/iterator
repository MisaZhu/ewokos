// iterator_traits specializations
template <typename T>
struct iterator_traits<base_iterator<T>> {
    using difference_type = typename base_iterator<T>::difference_type;
    using value_type = typename base_iterator<T>::value_type;
    using pointer = typename base_iterator<T>::pointer;
    using reference = typename base_iterator<T>::reference;
    using iterator_category = typename base_iterator<T>::iterator_category;
