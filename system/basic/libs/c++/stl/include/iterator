struct iterator_traits<bidirectional_iterator<T>> {
    using difference_type = typename bidirectional_iterator<T>::difference_type;
    using value_type = typename bidirectional_iterator<T>::value_type;
    using pointer = typename bidirectional_iterator<T>::pointer;
    using reference = typename bidirectional_iterator<T>::reference;
    using iterator_category = typename bidirectional_iterator<T>::iterator_category;
};

