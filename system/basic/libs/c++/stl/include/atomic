#ifndef EWOK_STL_ATOMIC_H
#define EWOK_STL_ATOMIC_H

/*
 * <atomic> - std::atomic on GCC's __atomic builtins.
 *
 * QtCore cannot be compiled at all without this header.  qatomic_cxx11.h:45 does an
 * unconditional `#include <atomic>`, and qatomic_cxx11.h is what QBasicAtomicInteger
 * - and therefore QAtomicInt, QAtomicPointer and every implicitly shared Qt class -
 * is built on.  It is also the single largest gap EWOK_STL had: 45 uses of
 * std::atomic plus about 50 of the std::memory_order enumerators across corelib.
 *
 * It cannot be borrowed from the toolchain.  libstdc++'s <atomic> is on the include
 * path, but it fails with 129 errors once EWOK_STL's <type_traits> and <utility>
 * shadow the ones libstdc++ expects - its internals reach for std::__and_,
 * std::__conditional_t and a std::forward that then collides with ours.  Every
 * libstdc++ header EWOK_STL lacks behaves the same way, so the gaps have to be
 * filled here rather than fallen through.
 *
 * Everything is inline over the __atomic builtins, which is what makes this
 * header-only and library-free.  That matters twice over on this target:
 *
 *   - make.rule passes -mno-outline-atomics, so GCC emits the load-exclusive /
 *     store-exclusive loop inline instead of calling libgcc's __aarch64_ldadd4 and
 *     friends.  There is no libgcc atomic dependency to satisfy at link time.
 *   - make.rule does not link libstdc++.a at all (EWOK_LIB_X lists -lewokstl only),
 *     so anything needing an out-of-line definition would be an undefined symbol.
 *
 * The memory_order enumerators are given the values of the compiler's own
 * __ATOMIC_* macros rather than a 0..5 sequence of our own.  That is not cosmetic:
 * the builtins take the ordering as an int, and matching the compiler's numbering
 * means an order value can be passed straight through with no mapping function and
 * no switch to be kept in sync.  libstdc++ does the same.
 *
 * The ATOMIC_*_LOCK_FREE macros are likewise forwarded from __GCC_ATOMIC_*_LOCK_FREE
 * instead of being hardcoded to 2.  All eight are 2 on aarch64-virt, which is what
 * makes qatomic_cxx11.h take its *_IS_ALWAYS_NATIVE branches and QAtomicTraits<N>::
 * isLockFree() answer true; but EwokOS also builds for arm, x86 and riscv, and
 * forwarding keeps those ports honest without this header having to know anything
 * about them.
 *
 * One C++17 name is deliberately absent: atomic<T>::is_always_lock_free.  In C++14
 * a static constexpr data member needs an out-of-line definition if it is ODR-used,
 * and a header cannot supply one without `inline` variables.  is_lock_free() covers
 * everything here, and nothing in the Widgets build asks for the variable.
 */

#include <type_traits>   /* is_integral, is_pointer */
#include <stddef.h>      /* size_t, ptrdiff_t */
#include <stdint.h>      /* the fixed-width typedefs at the bottom */

/* C++11 [atomics.lockfree].  Forwarded from the compiler so that a port to a
   target where, say, 8-byte atomics need a lock reports 1 rather than lying.  */
#define ATOMIC_BOOL_LOCK_FREE       __GCC_ATOMIC_BOOL_LOCK_FREE
#define ATOMIC_CHAR_LOCK_FREE       __GCC_ATOMIC_CHAR_LOCK_FREE
#define ATOMIC_CHAR16_T_LOCK_FREE   __GCC_ATOMIC_CHAR16_T_LOCK_FREE
#define ATOMIC_CHAR32_T_LOCK_FREE   __GCC_ATOMIC_CHAR32_T_LOCK_FREE
#define ATOMIC_WCHAR_T_LOCK_FREE    __GCC_ATOMIC_WCHAR_T_LOCK_FREE
#define ATOMIC_SHORT_LOCK_FREE      __GCC_ATOMIC_SHORT_LOCK_FREE
#define ATOMIC_INT_LOCK_FREE        __GCC_ATOMIC_INT_LOCK_FREE
#define ATOMIC_LONG_LOCK_FREE       __GCC_ATOMIC_LONG_LOCK_FREE
#define ATOMIC_LLONG_LOCK_FREE      __GCC_ATOMIC_LLONG_LOCK_FREE
#define ATOMIC_POINTER_LOCK_FREE    __GCC_ATOMIC_POINTER_LOCK_FREE

/* Deprecated in C++17 and gone in C++20, but qatomic_cxx11.h:486 still spells it
   in its non-constexpr fallback branch.  Harmless to define. */
#ifndef ATOMIC_VAR_INIT
#define ATOMIC_VAR_INIT(a) (a)
#endif

namespace std {

/* Unscoped, as the standard has it, so that memory_order_relaxed is usable
   unqualified and so that the enumerators convert to the int the builtins want. */
enum memory_order : int {
    memory_order_relaxed = __ATOMIC_RELAXED,
    memory_order_consume = __ATOMIC_CONSUME,
    memory_order_acquire = __ATOMIC_ACQUIRE,
    memory_order_release = __ATOMIC_RELEASE,
    memory_order_acq_rel = __ATOMIC_ACQ_REL,
    memory_order_seq_cst = __ATOMIC_SEQ_CST
};

inline void atomic_thread_fence(memory_order order) noexcept {
    __atomic_thread_fence(order);
}

inline void atomic_signal_fence(memory_order order) noexcept {
    __atomic_signal_fence(order);
}

template <typename T>
inline T kill_dependency(T y) noexcept { return y; }

/* The failure ordering for the single-order compare_exchange overloads.  The
   standard forbids a failure order stronger than the success order, and forbids
   release and acq_rel on the failure path at all, so they are weakened here rather
   than being passed through and rejected by the builtin. */
constexpr memory_order __atomic_cas_failure(memory_order order) noexcept {
    return order == memory_order_release ? memory_order_relaxed
         : order == memory_order_acq_rel ? memory_order_acquire
         : order;
}

struct atomic_flag {
    /* A plain bool rather than __atomic_flag_data_t: __atomic_test_and_set wants a
       bool*, and the builtin is what supplies the atomicity, not the storage type. */
    bool value_;

    atomic_flag() = default;
    constexpr atomic_flag(bool initial) noexcept : value_(initial) {}

    atomic_flag(const atomic_flag&) = delete;
    atomic_flag& operator=(const atomic_flag&) = delete;
    atomic_flag& operator=(const atomic_flag&) volatile = delete;

    bool test_and_set(memory_order order = memory_order_seq_cst) noexcept {
        return __atomic_test_and_set(&value_, order);
    }
    bool test_and_set(memory_order order = memory_order_seq_cst) volatile noexcept {
        return __atomic_test_and_set(&value_, order);
    }

    void clear(memory_order order = memory_order_seq_cst) noexcept {
        __atomic_clear(&value_, order);
    }
    void clear(memory_order order = memory_order_seq_cst) volatile noexcept {
        __atomic_clear(&value_, order);
    }
};

#define ATOMIC_FLAG_INIT { false }

/*
 * Every member below comes in two flavours, plain and volatile-qualified.  That is
 * not defensive padding: qatomic_cxx11.h declares
 *
 *     template <typename T> static inline T loadAcquire(const volatile std::atomic<T>&)
 *
 * and calls _q_value.load(std::memory_order_acquire) through it, so without a
 * `const volatile` overload of load() QtCore does not compile.  libstdc++ carries
 * the same duplication for the same reason.
 */

/* Level 1: the operations that exist for every T. */
template <typename T>
struct __atomic_base {
    typedef T __value_type;

    /* Public and named value_ rather than private, because the derived levels reach
       it with __atomic builtins and a friend declaration per level would be more
       machinery than the member is worth. */
    __value_type value_;

    /* Trivial, so that `std::atomic<int> x;` leaves x uninitialized exactly as the
       standard requires - and so that QBasicAtomicInteger stays an aggregate. */
    __atomic_base() = default;

    /* constexpr is load-bearing.  qbasicatomic.h's QBasicAtomicInteger has no
       user-declared constructor, so qglobalstatic.h:154's
           QBasicAtomicInt guard = Q_BASIC_ATOMIC_INITIALIZER(QtGlobalStatic::Uninitialized);
       is aggregate initialisation, i.e. _q_value{0}, and that object has static
       storage duration.  A non-constexpr constructor would make it a dynamic
       initialiser - and with -fno-use-cxa-atexit there is nothing registered to
       run it before main. */
    constexpr __atomic_base(__value_type initial) noexcept : value_(initial) {}

    __atomic_base(const __atomic_base&) = delete;
    __atomic_base& operator=(const __atomic_base&) = delete;
    __atomic_base& operator=(const __atomic_base&) volatile = delete;

    __value_type operator=(__value_type desired) noexcept {
        store(desired);
        return desired;
    }
    __value_type operator=(__value_type desired) volatile noexcept {
        store(desired);
        return desired;
    }

    bool is_lock_free() const noexcept {
        return __atomic_is_lock_free(sizeof(__value_type), &value_);
    }
    bool is_lock_free() const volatile noexcept {
        return __atomic_is_lock_free(sizeof(__value_type), &value_);
    }

    void store(__value_type desired, memory_order order = memory_order_seq_cst) noexcept {
        __atomic_store_n(&value_, desired, order);
    }
    void store(__value_type desired, memory_order order = memory_order_seq_cst) volatile noexcept {
        __atomic_store_n(&value_, desired, order);
    }

    __value_type load(memory_order order = memory_order_seq_cst) const noexcept {
        return __atomic_load_n(&value_, order);
    }
    __value_type load(memory_order order = memory_order_seq_cst) const volatile noexcept {
        return __atomic_load_n(&value_, order);
    }

    operator __value_type() const noexcept { return load(); }
    operator __value_type() const volatile noexcept { return load(); }

    __value_type exchange(__value_type desired,
                          memory_order order = memory_order_seq_cst) noexcept {
        return __atomic_exchange_n(&value_, desired, order);
    }
    __value_type exchange(__value_type desired,
                          memory_order order = memory_order_seq_cst) volatile noexcept {
        return __atomic_exchange_n(&value_, desired, order);
    }

    /* `expected` is by reference and is written back with the observed value on
       failure, which is what lets qatomic_cxx11.h's testAndSet* report the current
       value through its optional T* out-parameter. */
    bool compare_exchange_weak(__value_type& expected, __value_type desired,
                               memory_order success, memory_order failure) noexcept {
        return __atomic_compare_exchange_n(&value_, &expected, desired, true, success, failure);
    }
    bool compare_exchange_weak(__value_type& expected, __value_type desired,
                               memory_order success, memory_order failure) volatile noexcept {
        return __atomic_compare_exchange_n(&value_, &expected, desired, true, success, failure);
    }
    bool compare_exchange_strong(__value_type& expected, __value_type desired,
                                 memory_order success, memory_order failure) noexcept {
        return __atomic_compare_exchange_n(&value_, &expected, desired, false, success, failure);
    }
    bool compare_exchange_strong(__value_type& expected, __value_type desired,
                                 memory_order success, memory_order failure) volatile noexcept {
        return __atomic_compare_exchange_n(&value_, &expected, desired, false, success, failure);
    }

    bool compare_exchange_weak(__value_type& expected, __value_type desired,
                               memory_order order = memory_order_seq_cst) noexcept {
        return compare_exchange_weak(expected, desired, order, __atomic_cas_failure(order));
    }
    bool compare_exchange_weak(__value_type& expected, __value_type desired,
                               memory_order order = memory_order_seq_cst) volatile noexcept {
        return compare_exchange_weak(expected, desired, order, __atomic_cas_failure(order));
    }
    bool compare_exchange_strong(__value_type& expected, __value_type desired,
                                 memory_order order = memory_order_seq_cst) noexcept {
        return compare_exchange_strong(expected, desired, order, __atomic_cas_failure(order));
    }
    bool compare_exchange_strong(__value_type& expected, __value_type desired,
                                 memory_order order = memory_order_seq_cst) volatile noexcept {
        return compare_exchange_strong(expected, desired, order, __atomic_cas_failure(order));
    }
};

/*
 * Level 2: the arithmetic and bitwise members, which only integral types have.
 * Selected by a bool parameter defaulted from is_integral rather than by SFINAE on
 * the members, because a member of a class template that is present for some T and
 * absent for others cannot be spelled any other way in C++14.  The upshot is that
 * std::atomic<SomeStruct> still compiles - it simply has no fetch_add - which the
 * standard allows and which nothing here depends on.
 *
 * Function bodies are only instantiated when called, so atomic<bool> compiling even
 * though the standard denies bool a fetch_add costs nothing: GCC would reject the
 * builtin, but nothing ever asks it to.
 */
template <typename T, bool = is_integral<T>::value>
struct __atomic_int_ops : __atomic_base<T> {
    __atomic_int_ops() = default;
    constexpr __atomic_int_ops(T initial) noexcept : __atomic_base<T>(initial) {}
};

template <typename T>
struct __atomic_int_ops<T, true> : __atomic_base<T> {
    typedef __atomic_base<T> __base;

    __atomic_int_ops() = default;
    constexpr __atomic_int_ops(T initial) noexcept : __base(initial) {}

    T fetch_add(T arg, memory_order order = memory_order_seq_cst) noexcept {
        return __atomic_fetch_add(&this->value_, arg, order);
    }
    T fetch_add(T arg, memory_order order = memory_order_seq_cst) volatile noexcept {
        return __atomic_fetch_add(&this->value_, arg, order);
    }

    T fetch_sub(T arg, memory_order order = memory_order_seq_cst) noexcept {
        return __atomic_fetch_sub(&this->value_, arg, order);
    }
    T fetch_sub(T arg, memory_order order = memory_order_seq_cst) volatile noexcept {
        return __atomic_fetch_sub(&this->value_, arg, order);
    }

    T fetch_and(T arg, memory_order order = memory_order_seq_cst) noexcept {
        return __atomic_fetch_and(&this->value_, arg, order);
    }
    T fetch_and(T arg, memory_order order = memory_order_seq_cst) volatile noexcept {
        return __atomic_fetch_and(&this->value_, arg, order);
    }

    T fetch_or(T arg, memory_order order = memory_order_seq_cst) noexcept {
        return __atomic_fetch_or(&this->value_, arg, order);
    }
    T fetch_or(T arg, memory_order order = memory_order_seq_cst) volatile noexcept {
        return __atomic_fetch_or(&this->value_, arg, order);
    }

    T fetch_xor(T arg, memory_order order = memory_order_seq_cst) noexcept {
        return __atomic_fetch_xor(&this->value_, arg, order);
    }
    T fetch_xor(T arg, memory_order order = memory_order_seq_cst) volatile noexcept {
        return __atomic_fetch_xor(&this->value_, arg, order);
    }

    /* Prefix hands back the *new* value, postfix the old one.  qatomic_cxx11.h:283
       is `return ++_q_value != 0;` for ref(), so the prefix form has to be the new
       value or a reference count that reaches zero on the way down would look like
       one that reached zero on the way up. */
    T operator++() noexcept { return fetch_add(T(1)) + T(1); }
    T operator++() volatile noexcept { return fetch_add(T(1)) + T(1); }
    T operator++(int) noexcept { return fetch_add(T(1)); }
    T operator++(int) volatile noexcept { return fetch_add(T(1)); }
    T operator--() noexcept { return fetch_sub(T(1)) - T(1); }
    T operator--() volatile noexcept { return fetch_sub(T(1)) - T(1); }
    T operator--(int) noexcept { return fetch_sub(T(1)); }
    T operator--(int) volatile noexcept { return fetch_sub(T(1)); }

    T operator+=(T arg) noexcept { return fetch_add(arg) + arg; }
    T operator+=(T arg) volatile noexcept { return fetch_add(arg) + arg; }
    T operator-=(T arg) noexcept { return fetch_sub(arg) - arg; }
    T operator-=(T arg) volatile noexcept { return fetch_sub(arg) - arg; }
    T operator&=(T arg) noexcept { return fetch_and(arg) & arg; }
    T operator&=(T arg) volatile noexcept { return fetch_and(arg) & arg; }
    T operator|=(T arg) noexcept { return fetch_or(arg) | arg; }
    T operator|=(T arg) volatile noexcept { return fetch_or(arg) | arg; }
    T operator^=(T arg) noexcept { return fetch_xor(arg) ^ arg; }
    T operator^=(T arg) volatile noexcept { return fetch_xor(arg) ^ arg; }
};

/* Level 2 for pointers: the same shape, but the delta is a ptrdiff_t.

   The scaling has to be done here.  __atomic_fetch_add on a pointer is a raw byte
   addition, not pointer arithmetic - GCC's own codegen for atomic<int*>::fetch_add(d)
   is

       ldaxr   x0, [x1]
       add     x3, x0, x2        <-- no `lsl #2`, so no sizeof(int) scaling
       stlxr   w4, x3, [x1]
       cbnz    w4, <retry>

   and clang behaves the same way.  Without __scale, fetch_add(1) on an int* would
   advance one byte and land on an address that is not even a valid int*.  libstdc++
   compensates identically, with _M_type_size() at atomic_base.h:695.

   __scale is a member function rather than a `static constexpr ptrdiff_t` data
   member on purpose: a data member is instantiated with the class, so
   std::atomic<void*> - which Qt uses for QBasicAtomicPointer<void> - would put
   sizeof(void) in front of -pedantic.  As a function body it is only instantiated
   if something actually calls fetch_add on a void*. */
template <typename T>
struct __atomic_ptr_ops : __atomic_base<T*> {
    typedef __atomic_base<T*> __base;

    ptrdiff_t __scale(ptrdiff_t arg) const noexcept { return arg * (ptrdiff_t)sizeof(T); }
    ptrdiff_t __scale(ptrdiff_t arg) const volatile noexcept { return arg * (ptrdiff_t)sizeof(T); }

    __atomic_ptr_ops() = default;
    constexpr __atomic_ptr_ops(T* initial) noexcept : __base(initial) {}

    T* fetch_add(ptrdiff_t arg, memory_order order = memory_order_seq_cst) noexcept {
        return __atomic_fetch_add(&this->value_, __scale(arg), order);
    }
    T* fetch_add(ptrdiff_t arg, memory_order order = memory_order_seq_cst) volatile noexcept {
        return __atomic_fetch_add(&this->value_, __scale(arg), order);
    }
    T* fetch_sub(ptrdiff_t arg, memory_order order = memory_order_seq_cst) noexcept {
        return __atomic_fetch_sub(&this->value_, __scale(arg), order);
    }
    T* fetch_sub(ptrdiff_t arg, memory_order order = memory_order_seq_cst) volatile noexcept {
        return __atomic_fetch_sub(&this->value_, __scale(arg), order);
    }

    /* The `+ 1` / `+ arg` on the result is ordinary pointer arithmetic and so is
       scaled by the compiler; only the builtin's argument needed help. */
    T* operator++() noexcept { return fetch_add(1) + 1; }
    T* operator++() volatile noexcept { return fetch_add(1) + 1; }
    T* operator++(int) noexcept { return fetch_add(1); }
    T* operator++(int) volatile noexcept { return fetch_add(1); }
    T* operator--() noexcept { return fetch_sub(1) - 1; }
    T* operator--() volatile noexcept { return fetch_sub(1) - 1; }
    T* operator--(int) noexcept { return fetch_sub(1); }
    T* operator--(int) volatile noexcept { return fetch_sub(1); }

    T* operator+=(ptrdiff_t arg) noexcept { return fetch_add(arg) + arg; }
    T* operator+=(ptrdiff_t arg) volatile noexcept { return fetch_add(arg) + arg; }
    T* operator-=(ptrdiff_t arg) noexcept { return fetch_sub(arg) - arg; }
    T* operator-=(ptrdiff_t arg) volatile noexcept { return fetch_sub(arg) - arg; }
};

template <typename T>
struct atomic : __atomic_int_ops<T> {
    typedef T value_type;
    typedef __atomic_int_ops<T> __ops;

    atomic() = default;
    constexpr atomic(T initial) noexcept : __ops(initial) {}

    atomic(const atomic&) = delete;
    atomic& operator=(const atomic&) = delete;
    atomic& operator=(const atomic&) volatile = delete;

    /* `this->store` rather than `__ops::operator=`.  A qualified call only
       considers the declarations at the level named, and __atomic_int_ops /
       __atomic_ptr_ops declare no operator= of their own - so `__ops::operator=`
       finds the implicitly declared move assignment, which is deleted because the
       base deletes copy assignment.  Going through `this->` does an ordinary
       unqualified lookup, which finds the inherited value-assigning operator=.
       libstdc++ avoids the trap differently, by qualifying at __atomic_base
       directly; it has no intermediate level to get wrong. */
    T operator=(T desired) noexcept { this->store(desired); return desired; }
    T operator=(T desired) volatile noexcept { this->store(desired); return desired; }
};

template <typename T>
struct atomic<T*> : __atomic_ptr_ops<T> {
    typedef T* value_type;
    typedef __atomic_ptr_ops<T> __ops;

    atomic() = default;
    constexpr atomic(T* initial) noexcept : __ops(initial) {}

    atomic(const atomic&) = delete;
    atomic& operator=(const atomic&) = delete;
    atomic& operator=(const atomic&) volatile = delete;

    T* operator=(T* desired) noexcept { this->store(desired); return desired; }
    T* operator=(T* desired) volatile noexcept { this->store(desired); return desired; }
};

/* [atomics.types.generic].  Spelled as typedefs of atomic<X> rather than separate
   classes, which is what the standard requires and what makes QAtomicInteger<T>'s
   Q_STATIC_ASSERT on sizeof(T) line up with the ATOMIC_*_LOCK_FREE macros above. */
typedef atomic<bool>               atomic_bool;
typedef atomic<char>               atomic_char;
typedef atomic<signed char>        atomic_schar;
typedef atomic<unsigned char>      atomic_uchar;
typedef atomic<short>              atomic_short;
typedef atomic<unsigned short>     atomic_ushort;
typedef atomic<int>                atomic_int;
typedef atomic<unsigned int>       atomic_uint;
typedef atomic<long>               atomic_long;
typedef atomic<unsigned long>      atomic_ulong;
typedef atomic<long long>          atomic_llong;
typedef atomic<unsigned long long> atomic_ullong;
typedef atomic<char16_t>           atomic_char16_t;
typedef atomic<char32_t>           atomic_char32_t;
typedef atomic<wchar_t>            atomic_wchar_t;

typedef atomic<int8_t>             atomic_int8_t;
typedef atomic<uint8_t>            atomic_uint8_t;
typedef atomic<int16_t>            atomic_int16_t;
typedef atomic<uint16_t>           atomic_uint16_t;
typedef atomic<int32_t>            atomic_int32_t;
typedef atomic<uint32_t>           atomic_uint32_t;
typedef atomic<int64_t>            atomic_int64_t;
typedef atomic<uint64_t>           atomic_uint64_t;

typedef atomic<int_least8_t>       atomic_int_least8_t;
typedef atomic<uint_least8_t>      atomic_uint_least8_t;
typedef atomic<int_least16_t>      atomic_int_least16_t;
typedef atomic<uint_least16_t>     atomic_uint_least16_t;
typedef atomic<int_least32_t>      atomic_int_least32_t;
typedef atomic<uint_least32_t>     atomic_uint_least32_t;
typedef atomic<int_least64_t>      atomic_int_least64_t;
