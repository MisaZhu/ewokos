#ifndef EWOK_STL_CMATH_H
#define EWOK_STL_CMATH_H

/*
 * <cmath> - the C <math.h> names, in namespace std.
 *
 * EwokOS's <math.h> implements fabs/sqrt and friends as `static inline` over
 * GCC builtins, and isnan/isinf/isfinite as function-like MACROS.  A
 * using-declaration cannot name a macro, so the classification functions are
 * defined here as real overloads after #undef-ing the macros (see below).
 */

#include <math.h>

namespace std {

using ::fabs;
using ::fabsf;
using ::fabsl;

using ::sqrt;
using ::sqrtf;
using ::cbrt;
using ::cbrtf;
using ::hypot;
using ::hypotf;

using ::sin;
using ::sinf;
using ::cos;
using ::cosf;
using ::tan;
using ::tanf;
using ::asin;
using ::asinf;
using ::acos;
using ::acosf;
using ::atan;
using ::atanf;
using ::atan2;
using ::atan2f;

using ::sinh;
using ::sinhf;
using ::cosh;
using ::coshf;
using ::tanh;
using ::tanhf;
using ::asinh;
using ::asinhf;
using ::acosh;
using ::acoshf;
using ::atanh;
using ::atanhf;

using ::exp;
using ::expf;
using ::exp2;
using ::exp2f;
using ::log;
using ::logf;
using ::log2;
using ::log2f;
using ::log10;
using ::log10f;
using ::pow;
using ::powf;

using ::ceil;
using ::ceilf;
using ::floor;
using ::floorf;
using ::round;
using ::roundf;
using ::lround;
using ::lroundf;
using ::llround;
using ::llroundf;
using ::trunc;
using ::truncf;
using ::rint;
using ::rintf;
using ::nearbyint;
using ::nearbyintf;
using ::lrint;
using ::lrintf;
using ::llrint;
