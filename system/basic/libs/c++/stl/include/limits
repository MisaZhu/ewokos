#ifndef EWOK_STL_LIMITS_H
#define EWOK_STL_LIMITS_H

/*
 * <limits> - std::numeric_limits for the builtin types.
 *
 * Qt names numeric_limits in 122 places across corelib/gui/widgets, always on a
 * builtin type or on a template parameter: max() 67 times, min() 23, digits 6,
 * infinity/quiet_NaN/has_infinity a handful each.  qfloat16 is the one class
 * type, and Qt specializes numeric_limits for it itself in qfloat16.h, so the
 * primary template only has to exist for that specialization to be legal.
 *
 * Two things shaped the implementation:
 *
 * 1. Every constant comes from GCC's predefined target macros (__FLT_MANT_DIG__,
 *    __CHAR_BIT__, __WCHAR_UNSIGNED__, ...) rather than from a literal, so the
 *    header stays correct for the other ARCH values under system/platform/
 *    instead of just aarch64 - char and wchar_t change signedness by target.
 *
 * 2. The values live in class *templates* (__limits_integer, __limits_floating)
 *    that the numeric_limits specializations inherit from, and each static
 *    constexpr data member gets an out-of-line definition at the bottom of the
 *    file.  Both halves matter.  Under -std=c++14 a static constexpr data member
 *    is not implicitly inline the way it becomes in C++17, so taking its address
 *    emits an undefined reference that no library provides - and make.rule
 *    builds with plain -g and no -O when DEBUG=yes, which is exactly the level
 *    that fails to fold such an address away.  Out-of-line definitions fix that,
 *    but in a header they are only legal for a template: written against
 *    `numeric_limits<int>` directly they would be a multiple-definition error in
 *    every translation unit that includes this file.  Deriving from a template
 *    gives us both, and it is why every base here takes exactly one template
 *    parameter - the definitions at the bottom are generated by a macro, and
 *    `template <class T, bool S, int D>` would have its commas eaten as macro
 *    argument separators.
 */

#include <type_traits>

namespace std {

enum float_round_style {
    round_indeterminate = -1,
    round_toward_zero = 0,
    round_to_nearest = 1,
    round_toward_infinity = 2,
    round_toward_neg_infinity = 3
};

enum float_denorm_style {
    denorm_indeterminate = -1,
    denorm_absent = 0,
    denorm_present = 1
};

/* ------------------------------------------------------------------ *
 * Same width, unsigned.
 *
 * min()/max() are built by making an all-ones pattern and shifting it right in
 * the *unsigned* domain, because shifting a negative signed value is
 * implementation-defined and overflowing one is undefined - neither is
 * acceptable inside a constexpr function.  std::make_unsigned is the obvious
 * tool but it is ill-formed for bool, wchar_t, char16_t and char32_t before
 * C++20, and all four are needed here.
 * ------------------------------------------------------------------ */
template <class T> struct __ewok_unsigned { typedef T type; };
/* bool maps to unsigned char, not to bool: max() below applies ~ to the
   unsigned form, and -Wall's -Wbool-operation rejects '~' on a bool even in a
   branch that is discarded at compile time.  0xFF cast back to bool is true,
   which is the value we want anyway. */
template <> struct __ewok_unsigned<bool>               { typedef unsigned char type; };
template <> struct __ewok_unsigned<char>               { typedef unsigned char type; };
template <> struct __ewok_unsigned<signed char>        { typedef unsigned char type; };
template <> struct __ewok_unsigned<unsigned char>      { typedef unsigned char type; };
template <> struct __ewok_unsigned<short>              { typedef unsigned short type; };
template <> struct __ewok_unsigned<unsigned short>     { typedef unsigned short type; };
template <> struct __ewok_unsigned<int>                { typedef unsigned int type; };
template <> struct __ewok_unsigned<unsigned int>       { typedef unsigned int type; };
template <> struct __ewok_unsigned<long>               { typedef unsigned long type; };
template <> struct __ewok_unsigned<unsigned long>      { typedef unsigned long type; };
template <> struct __ewok_unsigned<long long>          { typedef unsigned long long type; };
template <> struct __ewok_unsigned<unsigned long long> { typedef unsigned long long type; };
#ifdef __WCHAR_UNSIGNED__
template <> struct __ewok_unsigned<wchar_t>            { typedef __UINT32_TYPE__ type; };
#else
template <> struct __ewok_unsigned<wchar_t>            { typedef __INT32_TYPE__ type; };
#endif
template <> struct __ewok_unsigned<char16_t>           { typedef __UINT_LEAST16_TYPE__ type; };
template <> struct __ewok_unsigned<char32_t>           { typedef __UINT_LEAST32_TYPE__ type; };

/* Whether the integral type carries a sign.  char and wchar_t are the two the
   target decides, and GCC predefines a macro for each. */
template <class T> struct __ewok_signed_int : false_type {};
template <> struct __ewok_signed_int<signed char> : true_type {};
template <> struct __ewok_signed_int<short>       : true_type {};
template <> struct __ewok_signed_int<int>         : true_type {};
template <> struct __ewok_signed_int<long>        : true_type {};
template <> struct __ewok_signed_int<long long>   : true_type {};
#ifndef __CHAR_UNSIGNED__
template <> struct __ewok_signed_int<char>        : true_type {};
#endif
#ifndef __WCHAR_UNSIGNED__
template <> struct __ewok_signed_int<wchar_t>     : true_type {};
#endif

/* ------------------------------------------------------------------ *
 * Integral types.
 *
 * The per-type facts are reached through constexpr *functions* (__sgn and
 * friends) rather than data members: functions are implicitly inline and so
 * never need an out-of-line definition, which keeps the macro at the bottom of
 * the file down to the members callers actually see.
 * ------------------------------------------------------------------ */
template <class T>
struct __limits_integer {
    typedef typename __ewok_unsigned<T>::type __unsigned_t;

    static constexpr bool __sgn() { return __ewok_signed_int<T>::value; }
    static constexpr bool __is_bool() { return is_same<T, bool>::value; }

    static constexpr bool is_specialized = true;
    static constexpr bool is_signed = __sgn();
    static constexpr bool is_integer = true;
    static constexpr bool is_exact = true;
    static constexpr bool has_infinity = false;
    static constexpr bool has_quiet_NaN = false;
    static constexpr bool has_signaling_NaN = false;
    static constexpr bool has_denorm_loss = false;
    static constexpr bool is_iec559 = false;
    static constexpr bool is_bounded = true;
    static constexpr bool tinyness_before = false;
    /* bool is the one integral type that neither wraps nor traps. */
    static constexpr bool is_modulo = !__sgn() && !__is_bool();
    static constexpr bool traps = !__is_bool();

    /* bool holds one value bit, not sizeof(bool) * CHAR_BIT of them. */
    static constexpr int digits =
        __is_bool() ? 1 : (int)(sizeof(T) * __CHAR_BIT__) - (__sgn() ? 1 : 0);
    /* log10(2) truncated to three decimals, i.e. digits * 0.301.  It reproduces
       every value the standard lists, from char (7 -> 2) and short (15 -> 4)
       through int (31 -> 9) and unsigned long long (64 -> 19). */
    static constexpr int digits10 = (digits * 301) / 1000;
    static constexpr int max_digits10 = 0;
    static constexpr int radix = 2;
    static constexpr int min_exponent = 0;
    static constexpr int min_exponent10 = 0;
    static constexpr int max_exponent = 0;
    static constexpr int max_exponent10 = 0;

    static constexpr float_round_style round_style = round_toward_zero;
    static constexpr float_denorm_style has_denorm = denorm_absent;

    static constexpr T max() noexcept {
        return __sgn()
            ? static_cast<T>(static_cast<__unsigned_t>(~static_cast<__unsigned_t>(0)) >> 1)
            : static_cast<T>(~static_cast<__unsigned_t>(0));
    }
    /* Spelled 0 - max - 1 rather than ~max() so that every intermediate value is
       representable and nothing overflows. */
    static constexpr T min() noexcept {
        return __sgn() ? static_cast<T>(T(0) - max() - T(1)) : static_cast<T>(0);
    }
    static constexpr T lowest() noexcept { return min(); }
    static constexpr T epsilon() noexcept { return static_cast<T>(0); }
    static constexpr T round_error() noexcept { return static_cast<T>(0); }
    static constexpr T infinity() noexcept { return static_cast<T>(0); }
    static constexpr T quiet_NaN() noexcept { return static_cast<T>(0); }
    static constexpr T signaling_NaN() noexcept { return static_cast<T>(0); }
    static constexpr T denorm_min() noexcept { return static_cast<T>(0); }
};

/* ------------------------------------------------------------------ *
 * Floating point.
 *
 * Same reasoning as above: __limits_fp_traits is written as explicit
 * specializations, and a specialization's static data member cannot have an
 * out-of-line definition in a header without colliding across translation
 * units, so the constants are functions.
 *
 * radix is __FLT_RADIX__ for all three types - GCC predefines that one macro
 * and no __DBL_RADIX__/__LDBL_RADIX__, which is correct because C's FLT_RADIX
 * describes every floating type on the target.
 * ------------------------------------------------------------------ */
template <class T> struct __limits_fp_traits;

template <> struct __limits_fp_traits<float> {
    static constexpr int digits() { return __FLT_MANT_DIG__; }
    static constexpr int digits10() { return __FLT_DIG__; }
    static constexpr int max_digits10() { return __FLT_DECIMAL_DIG__; }
    static constexpr int radix() { return __FLT_RADIX__; }
    static constexpr int min_exponent() { return __FLT_MIN_EXP__; }
    static constexpr int min_exponent10() { return __FLT_MIN_10_EXP__; }
    static constexpr int max_exponent() { return __FLT_MAX_EXP__; }
    static constexpr int max_exponent10() { return __FLT_MAX_10_EXP__; }
    static constexpr bool has_infinity() { return __FLT_HAS_INFINITY__ != 0; }
    static constexpr bool has_quiet_NaN() { return __FLT_HAS_QUIET_NAN__ != 0; }
    static constexpr bool has_denorm() { return __FLT_HAS_DENORM__ != 0; }
    static constexpr float min() { return __FLT_MIN__; }
    static constexpr float max() { return __FLT_MAX__; }
    static constexpr float epsilon() { return __FLT_EPSILON__; }
    static constexpr float denorm_min() { return __FLT_DENORM_MIN__; }
    /* __builtin_inf* rather than __builtin_huge_val*: HUGE_VAL is only
       guaranteed to be a value that overflows, whereas these are +infinity,
       which is what has_infinity claims we have. */
    static constexpr float infinity() { return __builtin_inff(); }
    static constexpr float quiet_NaN() { return __builtin_nanf(""); }
    static constexpr float signaling_NaN() { return __builtin_nansf(""); }
};

template <> struct __limits_fp_traits<double> {
    static constexpr int digits() { return __DBL_MANT_DIG__; }
    static constexpr int digits10() { return __DBL_DIG__; }
    static constexpr int max_digits10() { return __DBL_DECIMAL_DIG__; }
    static constexpr int radix() { return __FLT_RADIX__; }
    static constexpr int min_exponent() { return __DBL_MIN_EXP__; }
    static constexpr int min_exponent10() { return __DBL_MIN_10_EXP__; }
    static constexpr int max_exponent() { return __DBL_MAX_EXP__; }
    static constexpr int max_exponent10() { return __DBL_MAX_10_EXP__; }
    static constexpr bool has_infinity() { return __DBL_HAS_INFINITY__ != 0; }
    static constexpr bool has_quiet_NaN() { return __DBL_HAS_QUIET_NAN__ != 0; }
    static constexpr bool has_denorm() { return __DBL_HAS_DENORM__ != 0; }
    static constexpr double min() { return __DBL_MIN__; }
    static constexpr double max() { return __DBL_MAX__; }
    static constexpr double epsilon() { return __DBL_EPSILON__; }
    static constexpr double denorm_min() { return __DBL_DENORM_MIN__; }
    static constexpr double infinity() { return __builtin_inf(); }
    static constexpr double quiet_NaN() { return __builtin_nan(""); }
    static constexpr double signaling_NaN() { return __builtin_nans(""); }
};

template <> struct __limits_fp_traits<long double> {
    static constexpr int digits() { return __LDBL_MANT_DIG__; }
    static constexpr int digits10() { return __LDBL_DIG__; }
    static constexpr int max_digits10() { return __LDBL_DECIMAL_DIG__; }
    static constexpr int radix() { return __FLT_RADIX__; }
    static constexpr int min_exponent() { return __LDBL_MIN_EXP__; }
    static constexpr int min_exponent10() { return __LDBL_MIN_10_EXP__; }
    static constexpr int max_exponent() { return __LDBL_MAX_EXP__; }
    static constexpr int max_exponent10() { return __LDBL_MAX_10_EXP__; }
    static constexpr bool has_infinity() { return __LDBL_HAS_INFINITY__ != 0; }
    static constexpr bool has_quiet_NaN() { return __LDBL_HAS_QUIET_NAN__ != 0; }
    static constexpr bool has_denorm() { return __LDBL_HAS_DENORM__ != 0; }
    static constexpr long double min() { return __LDBL_MIN__; }
    static constexpr long double max() { return __LDBL_MAX__; }
    static constexpr long double epsilon() { return __LDBL_EPSILON__; }
    static constexpr long double denorm_min() { return __LDBL_DENORM_MIN__; }
    static constexpr long double infinity() { return __builtin_infl(); }
    static constexpr long double quiet_NaN() { return __builtin_nanl(""); }
    static constexpr long double signaling_NaN() { return __builtin_nansl(""); }
};

template <class T>
struct __limits_floating {
    typedef __limits_fp_traits<T> __traits;

    static constexpr bool is_specialized = true;
    static constexpr bool is_signed = true;
    static constexpr bool is_integer = false;
    static constexpr bool is_exact = false;
    static constexpr bool is_bounded = true;
    static constexpr bool is_modulo = false;
    /* Raising the invalid/overflow flags is observable but does not trap here. */
    static constexpr bool traps = false;
    static constexpr bool tinyness_before = true;
    static constexpr bool has_denorm_loss = true;

    static constexpr int digits = __traits::digits();
    static constexpr int digits10 = __traits::digits10();
    static constexpr int max_digits10 = __traits::max_digits10();
    static constexpr int radix = __traits::radix();
    static constexpr int min_exponent = __traits::min_exponent();
    static constexpr int min_exponent10 = __traits::min_exponent10();
    static constexpr int max_exponent = __traits::max_exponent();
    static constexpr int max_exponent10 = __traits::max_exponent10();

    static constexpr bool has_infinity = __traits::has_infinity();
    static constexpr bool has_quiet_NaN = __traits::has_quiet_NaN();
    static constexpr bool has_signaling_NaN = __traits::has_quiet_NaN();
    static constexpr bool is_iec559 =
        __traits::has_infinity() && __traits::has_quiet_NaN() && __traits::has_denorm();

    static constexpr float_round_style round_style = round_to_nearest;
    static constexpr float_denorm_style has_denorm =
        __traits::has_denorm() ? denorm_present : denorm_absent;

    /* min() is the smallest *normalised* value; lowest() is the most negative
       finite one.  The two are easy to confuse and Qt uses both. */
    static constexpr T min() noexcept { return __traits::min(); }
    static constexpr T max() noexcept { return __traits::max(); }
    static constexpr T lowest() noexcept { return -__traits::max(); }
    static constexpr T epsilon() noexcept { return __traits::epsilon(); }
    static constexpr T round_error() noexcept { return static_cast<T>(0.5); }
    static constexpr T infinity() noexcept { return __traits::infinity(); }
    static constexpr T quiet_NaN() noexcept { return __traits::quiet_NaN(); }
    static constexpr T signaling_NaN() noexcept { return __traits::signaling_NaN(); }
    static constexpr T denorm_min() noexcept { return __traits::denorm_min(); }
};

/* ------------------------------------------------------------------ *
 * numeric_limits
 * ------------------------------------------------------------------ */

/* The primary template: not specialized, so every query answers "unknown" and
   every value-returning member yields a value-initialised T.  Qt instantiates
   this for its own template parameters (numeric_limits<T>, 12 uses) and for
   qfloat16, which it specializes itself.  A T that is not default-constructible
   is still fine as long as nobody calls the value members - their bodies are
   only instantiated on use. */
template <class T>
struct numeric_limits {
    static constexpr bool is_specialized = false;
    static constexpr bool is_signed = false;
    static constexpr bool is_integer = false;
    static constexpr bool is_exact = false;
    static constexpr bool has_infinity = false;
    static constexpr bool has_quiet_NaN = false;
    static constexpr bool has_signaling_NaN = false;
    static constexpr bool has_denorm_loss = false;
    static constexpr bool is_iec559 = false;
    static constexpr bool is_bounded = false;
    static constexpr bool is_modulo = false;
    static constexpr bool traps = false;
    static constexpr bool tinyness_before = false;

    static constexpr int digits = 0;
    static constexpr int digits10 = 0;
    static constexpr int max_digits10 = 0;
    static constexpr int radix = 0;
    static constexpr int min_exponent = 0;
    static constexpr int min_exponent10 = 0;
    static constexpr int max_exponent = 0;
    static constexpr int max_exponent10 = 0;

    static constexpr float_round_style round_style = round_indeterminate;
    static constexpr float_denorm_style has_denorm = denorm_indeterminate;

    static constexpr T min() noexcept { return T(); }
    static constexpr T max() noexcept { return T(); }
    static constexpr T lowest() noexcept { return T(); }
    static constexpr T epsilon() noexcept { return T(); }
    static constexpr T round_error() noexcept { return T(); }
    static constexpr T infinity() noexcept { return T(); }
    static constexpr T quiet_NaN() noexcept { return T(); }
    static constexpr T signaling_NaN() noexcept { return T(); }
    static constexpr T denorm_min() noexcept { return T(); }
};

template <> struct numeric_limits<bool> : __limits_integer<bool> {};

template <> struct numeric_limits<char> : __limits_integer<char> {};
template <> struct numeric_limits<signed char> : __limits_integer<signed char> {};
template <> struct numeric_limits<unsigned char> : __limits_integer<unsigned char> {};
template <> struct numeric_limits<wchar_t> : __limits_integer<wchar_t> {};
template <> struct numeric_limits<char16_t> : __limits_integer<char16_t> {};
template <> struct numeric_limits<char32_t> : __limits_integer<char32_t> {};

template <> struct numeric_limits<short> : __limits_integer<short> {};
template <> struct numeric_limits<unsigned short> : __limits_integer<unsigned short> {};
template <> struct numeric_limits<int> : __limits_integer<int> {};
template <> struct numeric_limits<unsigned int> : __limits_integer<unsigned int> {};
template <> struct numeric_limits<long> : __limits_integer<long> {};
template <> struct numeric_limits<unsigned long> : __limits_integer<unsigned long> {};
template <> struct numeric_limits<long long> : __limits_integer<long long> {};
template <> struct numeric_limits<unsigned long long>
    : __limits_integer<unsigned long long> {};

template <> struct numeric_limits<float> : __limits_floating<float> {};
template <> struct numeric_limits<double> : __limits_floating<double> {};
template <> struct numeric_limits<long double> : __limits_floating<long double> {};

/* A cv-qualified type reports what the unqualified one does.  Qt does write
   numeric_limits<volatile qfloat16>, so these are not purely theoretical. */
template <class T> struct numeric_limits<const T> : numeric_limits<T> {};
template <class T> struct numeric_limits<volatile T> : numeric_limits<T> {};
template <class T> struct numeric_limits<const volatile T> : numeric_limits<T> {};

/* ------------------------------------------------------------------ *
 * Out-of-line definitions - see note 2 at the top of the file.
 *
 * __VA_ARGS__ rather than a named parameter because the class names contain
 * commas, which would otherwise be read as macro argument separators.
 * ------------------------------------------------------------------ */
#define EWOK_STL_DEFINE_LIMITS_MEMBERS(...)                                    \
    template <class T> constexpr bool __VA_ARGS__::is_specialized;             \
    template <class T> constexpr bool __VA_ARGS__::is_signed;                  \
    template <class T> constexpr bool __VA_ARGS__::is_integer;                 \
    template <class T> constexpr bool __VA_ARGS__::is_exact;                   \
    template <class T> constexpr bool __VA_ARGS__::is_bounded;                 \
    template <class T> constexpr bool __VA_ARGS__::is_modulo;                  \
    template <class T> constexpr bool __VA_ARGS__::traps;                      \
    template <class T> constexpr bool __VA_ARGS__::tinyness_before;            \
    template <class T> constexpr bool __VA_ARGS__::has_denorm_loss;            \
    template <class T> constexpr bool __VA_ARGS__::has_infinity;               \
    template <class T> constexpr bool __VA_ARGS__::has_quiet_NaN;              \
    template <class T> constexpr bool __VA_ARGS__::has_signaling_NaN;          \
    template <class T> constexpr bool __VA_ARGS__::is_iec559;                  \
    template <class T> constexpr int __VA_ARGS__::digits;                      \
    template <class T> constexpr int __VA_ARGS__::digits10;                    \
    template <class T> constexpr int __VA_ARGS__::max_digits10;                \
    template <class T> constexpr int __VA_ARGS__::radix;                       \
    template <class T> constexpr int __VA_ARGS__::min_exponent;                \
    template <class T> constexpr int __VA_ARGS__::min_exponent10;              \
    template <class T> constexpr int __VA_ARGS__::max_exponent;                \
    template <class T> constexpr int __VA_ARGS__::max_exponent10;              \
    template <class T> constexpr float_round_style __VA_ARGS__::round_style;   \
    template <class T> constexpr float_denorm_style __VA_ARGS__::has_denorm;

EWOK_STL_DEFINE_LIMITS_MEMBERS(__limits_integer<T>)
EWOK_STL_DEFINE_LIMITS_MEMBERS(__limits_floating<T>)
EWOK_STL_DEFINE_LIMITS_MEMBERS(numeric_limits<T>)

#undef EWOK_STL_DEFINE_LIMITS_MEMBERS

}

#endif // EWOK_STL_LIMITS_H
