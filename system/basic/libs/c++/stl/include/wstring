#ifndef EWOK_STL_WSTRING_H
#define EWOK_STL_WSTRING_H

#include <string.h>
#include <stddef.h>
#include <stdlib.h>
#include <stdint.h>

namespace std {

// wchar_t is a C++ built-in type, no need to redefine it

class wstring {
    public:
        /* The names every container is required to carry.  size_type was the
           only one here, so anything generic that named wstring::value_type or
           iterated it with wstring::iterator failed to compile.  The iterators
           are raw pointers, which is what the other containers in this STL do
           and what makes begin()/end() free functions in <iterator> work. */
        typedef wchar_t value_type;
        typedef size_t size_type;
        typedef ptrdiff_t difference_type;
        typedef wchar_t& reference;
        typedef const wchar_t& const_reference;
        typedef wchar_t* pointer;
        typedef const wchar_t* const_pointer;
        typedef wchar_t* iterator;
        typedef const wchar_t* const_iterator;
        static const size_t npos = -1;

        wstring() : data_(nullptr), length_(0), capacity_(1) {
            /* capacity_ counts the terminator, so a fresh string holding nothing
               has capacity 1, not 0.  It used to be initialized to 0 while still
               allocating room for the terminator, which made capacity() return
               (size_t)-1. */
            data_ = (wchar_t*)malloc(sizeof(wchar_t));
            data_[0] = 0;
        }

        wstring(const wstring& str) : data_(nullptr), length_(0), capacity_(0) {
            length_ = str.length_;
            capacity_ = length_ + 1;
            data_ = (wchar_t*)malloc(capacity_ * sizeof(wchar_t));
            for (size_t i = 0; i <= length_; i++) {
                data_[i] = str.data_[i];
            }
        }

        wstring(const wstring& str, size_t pos, size_t len = npos) : data_(nullptr), length_(0), capacity_(0) {
            if (pos > str.length_) {
                pos = str.length_;
            }
            if (len == npos || pos + len > str.length_) {
                len = str.length_ - pos;
            }
            length_ = len;
            capacity_ = length_ + 1;
            data_ = (wchar_t*)malloc(capacity_ * sizeof(wchar_t));
            for (size_t i = 0; i < len; i++) {
                data_[i] = str.data_[pos + i];
            }
            data_[length_] = 0;
        }

        wstring(const wchar_t* s) : data_(nullptr), length_(0), capacity_(0) {
            length_ = 0;
            while (s[length_] != 0) length_++;
            capacity_ = length_ + 1;
            data_ = (wchar_t*)malloc(capacity_ * sizeof(wchar_t));
            for (size_t i = 0; i <= length_; i++) {
                data_[i] = s[i];
            }
        }

        wstring(const wchar_t* s, size_t n) : data_(nullptr), length_(0), capacity_(0) {
            length_ = n;
            capacity_ = length_ + 1;
            data_ = (wchar_t*)malloc(capacity_ * sizeof(wchar_t));
            for (size_t i = 0; i < n; i++) {
                data_[i] = s[i];
            }
            data_[length_] = 0;
        }

        wstring(size_t n, wchar_t c) : data_(nullptr), length_(0), capacity_(0) {
            length_ = n;
            capacity_ = length_ + 1;
            data_ = (wchar_t*)malloc(capacity_ * sizeof(wchar_t));
            for (size_t i = 0; i < n; i++) {
                data_[i] = c;
            }
            data_[length_] = 0;
        }

        ~wstring() {
            free(data_);
        }

        wstring& operator=(const wstring& str) {
            if (this != &str) {
                free(data_);
                length_ = str.length_;
                capacity_ = length_ + 1;
                data_ = (wchar_t*)malloc(capacity_ * sizeof(wchar_t));
                for (size_t i = 0; i <= length_; i++) {
                    data_[i] = str.data_[i];
                }
            }
            return *this;
        }

        wstring& operator=(const wchar_t* s) {
            free(data_);
            length_ = 0;
            while (s[length_] != 0) length_++;
            capacity_ = length_ + 1;
            data_ = (wchar_t*)malloc(capacity_ * sizeof(wchar_t));
            for (size_t i = 0; i <= length_; i++) {
                data_[i] = s[i];
            }
            return *this;
        }

        wstring& operator=(wchar_t c) {
            free(data_);
            length_ = 1;
            capacity_ = 2;
            data_ = (wchar_t*)malloc(capacity_ * sizeof(wchar_t));
            data_[0] = c;
            data_[1] = 0;
            return *this;
        }

        size_t size() const { return length_; }
        size_t length() const { return length_; }
        size_t max_size() const { return -1; }

        void resize(size_t n) {
            if (n > capacity_) {
                capacity_ = n + 1;
                wchar_t* newData = (wchar_t*)malloc(capacity_ * sizeof(wchar_t));
                for (size_t i = 0; i < length_; i++) {
                    newData[i] = data_[i];
                }
                free(data_);
                data_ = newData;
            }
            if (n > length_) {
                for (size_t i = length_; i < n; i++) {
                    data_[i] = 0;
                }
            }
            length_ = n;
            data_[length_] = 0;
        }

        void resize(size_t n, wchar_t c) {
            size_t oldLength = length_;
            resize(n);
            if (n > oldLength) {
                for (size_t i = oldLength; i < n; i++) {
                    data_[i] = c;
                }
            }
        }

        size_t capacity() const { return capacity_ - 1; }

        void reserve(size_t n = 0) {
            if (n + 1 > capacity_) {
                capacity_ = n + 1;
                wchar_t* newData = (wchar_t*)malloc(capacity_ * sizeof(wchar_t));
                for (size_t i = 0; i <= length_; i++) {
                    newData[i] = data_[i];
                }
                free(data_);
                data_ = newData;
            }
        }

        void clear() {
            length_ = 0;
            data_[0] = 0;
        }

        bool empty() const { return length_ == 0; }

        wchar_t& operator[](size_t pos) { return data_[pos]; }
        const wchar_t& operator[](size_t pos) const { return data_[pos]; }

        wchar_t& at(size_t pos) {
            if (pos >= length_) {
                // In a real implementation, this would throw std::out_of_range
                return data_[0];
            }
            return data_[pos];
        }

        const wchar_t& at(size_t pos) const {
            if (pos >= length_) {
                return data_[0];
            }
            return data_[pos];
        }

        /* front() is what qstring.h:1563 needs.  QString::toStdWString is
           compiled at C++14, so its __cplusplus >= 201703L branch is off and it
           takes the older path:

               std::wstring str;
               str.resize(length());
               if (length())
                   str.resize(toWCharArray(&str.front()));

           toWCharArray wants a writable wchar_t*, which is why front() has to
           return a reference and not a value, and why a non-const data() is
           provided alongside it - that is the C++17 branch's spelling of the
           same thing, and it costs one line to not have to come back here. */
        wchar_t& front() { return data_[0]; }
        const wchar_t& front() const { return data_[0]; }
        wchar_t& back() { return data_[length_ - 1]; }
        const wchar_t& back() const { return data_[length_ - 1]; }

        iterator begin() { return data_; }
        const_iterator begin() const { return data_; }
        const_iterator cbegin() const { return data_; }
        iterator end() { return data_ + length_; }
        const_iterator end() const { return data_ + length_; }
        const_iterator cend() const { return data_ + length_; }

        void push_back(wchar_t c) { operator+=(c); }
        void pop_back() {
            if (length_ > 0) {
                --length_;
                data_[length_] = 0;
            }
        }

        void swap(wstring& other) {
            wchar_t* tmpData = data_;
            size_t tmpLength = length_;
            size_t tmpCapacity = capacity_;
            data_ = other.data_;
            length_ = other.length_;
            capacity_ = other.capacity_;
            other.data_ = tmpData;
            other.length_ = tmpLength;
            other.capacity_ = tmpCapacity;
        }

        wstring& operator+=(const wstring& str) {
            size_t newLength = length_ + str.length_;
            if (newLength + 1 > capacity_) {
                capacity_ = newLength + 1;
                wchar_t* newData = (wchar_t*)malloc(capacity_ * sizeof(wchar_t));
                for (size_t i = 0; i < length_; i++) {
                    newData[i] = data_[i];
                }
                free(data_);
                data_ = newData;
            }
            for (size_t i = 0; i < str.length_; i++) {
                data_[length_ + i] = str.data_[i];
            }
            length_ = newLength;
            data_[length_] = 0;
            return *this;
        }

        wstring& operator+=(const wchar_t* s) {
            size_t sLen = 0;
            while (s[sLen] != 0) sLen++;
            size_t newLength = length_ + sLen;
            if (newLength + 1 > capacity_) {
                capacity_ = newLength + 1;
                wchar_t* newData = (wchar_t*)malloc(capacity_ * sizeof(wchar_t));
                for (size_t i = 0; i < length_; i++) {
                    newData[i] = data_[i];
                }
                free(data_);
                data_ = newData;
            }
            for (size_t i = 0; i < sLen; i++) {
                data_[length_ + i] = s[i];
            }
            length_ = newLength;
            data_[length_] = 0;
            return *this;
        }

        wstring& operator+=(wchar_t c) {
            if (length_ + 2 > capacity_) {
                capacity_ = length_ + 2;
                wchar_t* newData = (wchar_t*)malloc(capacity_ * sizeof(wchar_t));
                for (size_t i = 0; i < length_; i++) {
                    newData[i] = data_[i];
                }
                free(data_);
                data_ = newData;
            }
            data_[length_] = c;
            length_++;
            data_[length_] = 0;
            return *this;
        }

        /* append() is operator+= with a name and a couple of extra forms.
           qtermwidget's TerminalCharacterDecoder builds its HTML output with
           text.append(L"...") and text.append(QString(...).toStdWString()),
           which is what forced these in; the (s, n) and (n, c) overloads ride
           along because they reuse the same two lines each and their absence
           would be the next stop. */
        wstring& append(const wstring& str) { return operator+=(str); }
        wstring& append(const wchar_t* s) { return operator+=(s); }
        wstring& append(const wchar_t* s, size_t n) {
            return operator+=(wstring(s, n));
        }
        wstring& append(size_t n, wchar_t c) {
            return operator+=(wstring(n, c));
        }

        const wchar_t* c_str() const { return data_; }
        const wchar_t* data() const { return data_; }
        wchar_t* data() { return data_; }

        bool empty() { return length_ == 0; }

        wstring substr(size_t pos = 0, size_t len = npos) const {
            if (pos > length_) pos = length_;
            if (len == npos || pos + len > length_) len = length_ - pos;
            return wstring(data_ + pos, len);
        }

    private:
        wchar_t* data_;
        size_t length_;
        size_t capacity_;
};

}

#endif // EWOK_STL_WSTRING_H
