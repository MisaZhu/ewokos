AR = x86_64-elf-ar
AS = x86_64-elf-as
CCACHE := $(shell command -v ccache 2>/dev/null)
CC = $(CCACHE) x86_64-elf-gcc
CXX = $(CCACHE) x86_64-elf-c++
LD_BIN = x86_64-elf-ld
# ensure the output directory exists before linking (parallel-safe)
LD = mkdir -p $(dir $@) && $(LD_BIN)
OBJDUMP = x86_64-elf-objdump
LIBGCC = $(shell $(CC) -print-libgcc-file-name)

CFLAGS = -m64 \
	-Wno-implicit-function-declaration \
	-Wno-int-conversion \
	-Wall -Wextra -fPIC \
	-Wno-unused-parameter \
	-fno-strict-aliasing \
	-ffreestanding \
	-mno-red-zone \
	-std=c99

CXXFLAGS = -m64 \
	-Wall -Wextra -fPIC \
	-Wno-unused-parameter \
	-pedantic \
	-fno-rtti \
	-fno-exceptions \
	-fno-strict-aliasing \
	-fno-use-cxa-atexit \
	-ffreestanding \
	-mno-red-zone \
	-std=c++14

CFLAGS += -DARCH_BOOST
CXXFLAGS += -DARCH_BOOST

EWOK_LIBC = --start-group -lewoksys -lc -lgloss --end-group $(LIBGCC)
EWOK_LIB_GRAPH = -lfont -lfreetype -liconbuf -lgraph -lg2dclient -lpng -ljpeg -lgif -ltga -lsvg -lz -lopenlibm -ldisplayman -ldisplay -lkeyb -lmouse $(BSP_LFLAGS)
EWOK_LIB_X = -lwidget++ -lx++ -lx -ltinyjson -lewokstl -ltinyhttpsc -lsocket

ifeq ($(DEBUG),yes)
CFLAGS += -g
CXXFLAGS += -g
else
CFLAGS += -O2
CXXFLAGS += -O2
endif

STL_HEADERS_STAMP = $(BUILD_DIR)/include/.stl_headers_timestamp

$(ARCH)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(ARCH)/%.o: %.cc
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(ARCH)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(ARCH)/%.o: %.S
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(ARCH)/%.o: %.s
	@mkdir -p $(dir $@)
	$(AS) -o $@ $<
