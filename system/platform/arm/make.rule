# use ccache transparently when installed (brew install ccache)
CCACHE := $(shell command -v ccache 2>/dev/null)

AR = arm-none-eabi-ar
AS = arm-none-eabi-as
CC = $(CCACHE) arm-none-eabi-gcc
CXX = $(CCACHE) arm-none-eabi-c++
LD_BIN = arm-none-eabi-ld
# ensure the output directory exists before linking (parallel-safe)
LD = mkdir -p $(dir $@) && $(LD_BIN)
OBJDUMP = arm-none-eabi-objdump
LIBGCC = $(shell $(CC) -print-libgcc-file-name)

CFLAGS = -marm \
	-Wno-implicit-function-declaration \
	-mfloat-abi=softfp \
        -Wall -Wextra -fPIC -mapcs-frame \
        -Wno-unused-parameter \
	-Wno-int-conversion \
        -fno-builtin-memcpy \
        -fno-builtin-memmove \
        -fno-builtin-memset \
        -fno-builtin-calloc \
        -fno-strict-aliasing \
        -D__ewokos__=1 \
        -std=c99

# -nostdinc++: EWOK_STL is the only C++ standard library in scope.  See the longer
# note in system/platform/aarch64/make.rule.
CXXFLAGS = -marm \
	-nostdinc++ \
	-Wno-implicit-function-declaration \
	-mfloat-abi=softfp \
        -Wall -Wextra -fPIC -mapcs-frame \
        -Wno-unused-parameter \
	-Wno-int-conversion \
        -fno-builtin-memcpy \
        -fno-builtin-memmove \
        -fno-builtin-memset \
        -fno-builtin-calloc \
        -pedantic \
	-fno-rtti \
        -fno-exceptions \
        -fno-strict-aliasing \
        -fno-use-cxa-atexit \
        -D__ewokos__=1 \
        -std=c++14

ifeq ($(ARCH_VER),v7)
# -march=armv7-a is required so GCC emits inline ldrex/strex for the __sync_*
# atomic builtins; the baseline (armv4t) codegen instead calls __sync_*_4 out
# of libgcc, and the arm-none-eabi base libgcc.a does not provide them.
CFLAGS += -march=armv7-a -mfpu=neon-vfpv3 -DARCH_BOOST -mfloat-abi=softfp
CXXFLAGS += -march=armv7-a -mfpu=neon-vfpv3 -DARCH_BOOST -mfloat-abi=softfp
endif
       
EWOK_LIBC = --start-group -lewoksys -lc -lgloss -lsoftfloat --end-group $(LIBGCC)
EWOK_LIB_GRAPH = -lfont -lfreetype -liconbuf -lgraph -lg2dclient -lpng -ljpeg -lgif -ltga -lsvg -lz -lopenlibm -ldisplayman -ldisplay -lkeyb -lmouse  $(BSP_LFLAGS)
EWOK_LIB_X = -lwidget++ -lx++ -lx -ltinyjson -lewokstl

# --- shared objects: plugins loaded at runtime with dlopen() ---
#
# -shared is what makes GNU ld emit ET_DYN with a PT_DYNAMIC segment. The two
# near-misses do not work: -r produces ET_REL, which has relocations but no
# dynamic section, and a plain static link produces ET_EXEC, whose addresses
# are absolute - libdl rejects it rather than silently loading it at the wrong
# place.
#
# -nostdlib: EwokOS has no ET_DYN crt, and a plugin resolves every symbol
# against the host's export table (libs/dl/gen_export.sh) instead of carrying
# libraries of its own. Linking EWOK_LIBC into a plugin would give it a private
# malloc, a private stdio buffer and a private copy of the VFS state, none of
# which can work alongside the host's.
#
# Link a .so with $(CC), not $(LD): the driver picks the right emulation, and
# unlike ld it must not be given -Ttext - pinning the text section of a shared
# object would defeat the position independence that makes it loadable.
EWOK_SO_FLAGS = -shared -nostdlib

# What an app that HOSTS plugins links. -ldl goes before the EWOK_LIBC group
# because the generated export table's strong references are what make ld
# extract the libc members a plugin might call; a table of weak references
# would extract nothing and resolve to 0 at runtime.
EWOK_LIB_DL = -ldl $(EWOK_LIBC)

#CFLAGS +=  -g
CFLAGS +=  -O2
#CXXFLAGS +=  -g
CXXFLAGS +=  -O2

ARCH_CFLAGS = -marm  -mfloat-abi=softfp

STL_HEADERS_STAMP = $(BUILD_DIR)/include/.stl_headers_timestamp

$(ARCH)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(ARCH)/%.o: %.cc
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(ARCH)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(ARCH)/%.o: %.S
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(ARCH)/%.o: %.s
	@mkdir -p $(dir $@)
	$(AS) $(ARCH_CFLAGS) -o $@ $<
