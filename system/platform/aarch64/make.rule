# use ccache transparently when installed (brew install ccache)
CCACHE := $(shell command -v ccache 2>/dev/null)

AR = aarch64-none-elf-ar
AS = aarch64-none-elf-as
CC = $(CCACHE) aarch64-none-elf-gcc
CXX = $(CCACHE) aarch64-none-elf-c++
LD_BIN = aarch64-none-elf-ld
# ensure the output directory exists before linking (parallel-safe)
LD = mkdir -p $(dir $@) && $(LD_BIN)
OBJDUMP =  aarch64-none-elf-objdump

# NOTE: no -mstrict-align here. The kernel boots with SCTLR_EL1.A=0 (see
# kernel/platform/aarch64/arch/v8/boot.S), so unaligned loads/stores are
# legal; -mstrict-align made GCC scalarize every NEON memory access
# (vld1q/vst1q -> ldp w/orr/stp w), silently killing all ARCH_BOOST kernels.

CFLAGS =  -march=armv8-a -Wno-incompatible-pointer-types -Wno-int-conversion \
		-Wno-implicit-function-declaration \
        -Wall -Wextra -fPIC \
		-fno-builtin-memcpy \
		-fno-builtin-memmove \
		-fno-builtin-memset \
        -Wno-unused-parameter \
		-mstrict-align \
        -mno-outline-atomics \
        -std=c99

# -nostdinc++ closes off the toolchain's libstdc++ headers so that EWOK_STL, which
# the STL_HEADERS_STAMP rule below installs into $(BUILD_DIR)/include, is the only
# C++ standard library in scope.  Without it, a header EWOK_STL lacks silently falls
# through to libstdc++ - and then fails to compile, because libstdc++'s internals
# expect libstdc++'s <type_traits>/<utility> and find ours shadowing them instead
# (<chrono> 37 errors, <mutex> 57, <future> 560).  It also makes __has_include()
# report honestly, which is what Qt's feature detection is built on.  EWOK_LIB_X has
# never listed -lstdc++, so nothing is given up at link time either.
CXXFLAGS = -march=armv8-a \
        -nostdinc++ \
        -Wall -Wextra -fPIC \
		-fno-builtin-memcpy \
		-fno-builtin-memmove \
		-fno-builtin-memset \
        -Wno-unused-parameter \
        -pedantic \
		-fno-rtti \
		-mstrict-align \
        -mno-outline-atomics \
        -fno-exceptions \
        -fno-use-cxa-atexit \
        -std=c++14

CFLAGS += -DARCH_BOOST
CXXFLAGS += -DARCH_BOOST

EWOK_LIBC = --start-group -lewoksys -lc -lgloss --end-group
EWOK_LIB_GRAPH = -lfont -lfreetype -liconbuf -lgraph -lg2dclient -lpng -ljpeg -lgif -ltga -lsvg -lz -lopenlibm -ldisplayman -ldisplay -lkeyb -lmouse  $(BSP_LFLAGS)
EWOK_LIB_X = -lwidget++ -lx++ -lx -ltinyjson -lewokstl -ltinyhttpsc -lsocket

ifeq ($(DEBUG),yes)
CFLAGS +=  -g
CXXFLAGS +=  -g
else
CFLAGS +=  -O2
CXXFLAGS +=  -O2
endif

STL_HEADERS_STAMP = $(BUILD_DIR)/include/.stl_headers_timestamp

$(ARCH)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(ARCH)/%.o: %.cc
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(ARCH)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(ARCH)/%.o: %.S
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(ARCH)/%.o: %.s
	@mkdir -p $(dir $@)
	$(AS) $(ARCH_CFLAGS) -o $@ $<
